/*
 * Nickle test suite
 *
 * Semaphore counts beyond an int
 *
 * Semaphore counts were ints: Semaphore::new refused initial counts
 * beyond a small int, and signaling a semaphore enough times
 * overflowed its count. Counts now cover the signed_digit range (64
 * bits wherever C has a 64-bit integer type), and signal and wait
 * raise invalid_argument at its ends. Printing a semaphore read the
 * count as a ptrdiff_t, showing the wrong count on 32-bit targets.
 */

exception not_raised(string what);
exception wrong(string what, poly got, poly want);

void
check(string what, poly got, poly want)
{
    if (got ≠ want)
        raise wrong(what, got, want);
}

void
rejected(string what, void() f)
{
    try {
        f();
        raise not_raised(what);
    } catch invalid_argument(string m, poly a, poly b) {
    }
}

semaphore s = Semaphore::new(2⁴⁰);
check("new (2**40)", Semaphore::count(s), 2⁴⁰);
Semaphore::signal(s);
check("signal", Semaphore::count(s), 2⁴⁰ + 1);
Semaphore::wait(s);
Semaphore::wait(s);
check("wait", Semaphore::count(s), 2⁴⁰ - 1);
check("test", Semaphore::test(s), true);
check("after test", Semaphore::count(s), 2⁴⁰ - 2);

/* The ends of the range */
semaphore top = Semaphore::new(2⁶³ - 1);
rejected("signal at the top",
         void func() {
             Semaphore::signal(top);
         });
check("top unchanged", Semaphore::count(top), 2⁶³ - 1);

semaphore bottom = Semaphore::new(-(2⁶³));
rejected("wait at the bottom",
         void func() {
             Semaphore::wait(bottom);
         });
check("bottom unchanged", Semaphore::count(bottom), -(2⁶³));

rejected("new (2**70)",
         void func() {
             Semaphore::new(2⁷⁰);
         });

/* Printing shows the whole count */
string
printed_count(semaphore t)
{
    string p = sprintf("%v", t);
    int    i = String::index(p, "(");
    return String::substr(p, i, String::length(p) - i);
}

check("print top", printed_count(top), "(9223372036854775807)");
check("print bottom", printed_count(bottom), "(-9223372036854775808)");
check("print small", printed_count(Semaphore::new(-5)), "(-5)");
