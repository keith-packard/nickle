/*
 * Nickle test suite
 *
 * Complex log and pow precision
 *
 * log took the log of |z| rounded to the precision of z, losing the
 * real part's bits near |z| = 1. pow added bits for the exponents of
 * x's parts alone, while an absolute error in y log(x) becomes that
 * relative error in the result
 */

import Complex;

exception bad_result (string name, complex x, complex y, complex got,
		      complex want);

complex c (real r, real i) = cmplx (r, i);

/* Each part of log is correctly rounded */
void check_log (complex z, int prec)
{
    z = imprecise (z, prec);

    complex	got = Complex::log (z);
    complex	want = imprecise (Complex::log (imprecise (z, 600)), prec);

    if (got != want)
	raise bad_result ("log", z, 0, got, want);
}

complex[*] log_args = {
    c (1e-10, 1), c (1, 1e-12), c (1 - 2**-30, 1e-9), c (1, 2**-600),
    c (0.6, 0.8), c (-1, 1e-20), c (1e300, 1), c (3, 4), c (-2**-1000, -1),
};

for (int i = 0; i < dim (log_args); i++) {
    check_log (log_args[i], 53);
    check_log (log_args[i], 113);
}

try {
    Complex::log (c (0, 0));
    raise bad_result ("log", 0, 0, 0, 0);
} catch invalid_argument (string msg, int arg, poly value) {
}

/* pow is within half an ulp of |x**y| in each part */
void check_pow (complex x, complex y, int prec)
{
    x = imprecise (x, prec);
    y = imprecise (y, prec);

    complex	got = imprecise (Complex::pow (x, y), 600);
    complex	want = Complex::pow (imprecise (x, 600), imprecise (y, 600));
    real	ulp = Complex::abs (want) * 2 ** (1 - prec);
    real	err = max (Math::abs (creal (got) - creal (want)),
			   Math::abs (cimag (got) - cimag (want)));

    if (err > ulp * (1/2 + 2**-20))
	raise bad_result ("pow", x, y, got, want);
}

complex[*][2] pow_args = {
    { 2, 1000 }, { 1.0001, 100000 }, { c (1, 1), 40 },
    { c (0.5, 0.5), c (0, 1e5) }, { c (1, 1e-12), 1e12 },
    { c (2, 1), c (3.5, 7.25) }, { c (1e10, 1), 30 },
    { c (-3, 0.25), c (-200, 1000) },
};

for (int i = 0; i < dim (pow_args); i++) {
    check_pow (pow_args[i][0], pow_args[i][1], 53);
    check_pow (pow_args[i][0], pow_args[i][1], 113);
}
