/*
 * Nickle test suite
 *
 * Running programs with File::filter
 *
 * The child sent exec's errno as the first byte of an int, which is
 * the high byte on big-endian machines, and the parent read it into an
 * uninitialized int.
 */

exception not_raised (string what);
exception wrong (string what, poly got, poly want);

void function check (string what, poly got, poly want)
{
    if (got != want)
	raise wrong (what, got, want);
}

/* A program that runs writes its output to the pipe */
file[*] p = File::mkpipe ();
File::filter ("echo", (string[*]) { "echo", "filtered" },
	      (file[3]) { stdin, p[1], stderr });
File::close (p[1]);
check ("output", File::fgets (p[0]), "filtered");

/* A program that can't run reports exec's error */
try {
    File::filter ("/nonexistent/program", (string[*]) { "program" },
		  (file[3]) { stdin, stdout, stderr });
    raise not_raised ("filter");
} catch File::open_error (string m, File::error_type e, string name) {
    check ("error", e, File::error_type.NOENT);
}
