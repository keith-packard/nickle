/*
 * Nickle test suite
 *
 * ldexp test
 */
library "math-bits.5c"

void check_ldexp()
{
	printf("Checking ldexp\n");

	void same(string what, real v, real want) {
		if (v != want ||
		    (!is_rational(want) && precision(v) != precision(want))) {
			printf("check failed %s (was %.-g, should be %.-g)\n", what, v, want);
			errors++;
		}
	}

	same("ldexp(3, -2)", ldexp(3, -2), 3/4);
	same("ldexp(1/3, 5)", ldexp(1/3, 5), 32/3);
	same("ldexp(imprecise(1.5, 64), 10)", ldexp(imprecise(1.5, 64), 10), imprecise(1536, 64));
	same("ldexp(imprecise(-0.75, 100), -1074)", ldexp(imprecise(-0.75, 100), -1074),
	     imprecise(-0.75 * 2**-1074, 100));
	same("ldexp(imprecise(0, 64), 9)", ldexp(imprecise(0, 64), 9), imprecise(0, 64));

	/* huge exponents adjust the exponent without computing 2 ** e */
	real	big = ldexp(imprecise(0.75, 64), 2**100001);
	if (exponent(big) != 2**100001 || mantissa(big) != 3/4 ||
	    precision(big) != 64) {
		printf("check failed ldexp(0.75, 2**100001)\n");
		errors++;
	}
}

check_ldexp();
exit(errors);
