/*
 * Nickle test suite
 *
 * Very large integers
 *
 * Integer lengths and bit counts were ints, so results of 2**31 bits
 * or more overflowed them, and the scratch space for multiplying
 * values of 2**29 bits overflowed its byte count, aborting with "Out
 * of memory". Shift counts too large for a small int went through **,
 * and results too large to represent at all were never detected.
 */

exception not_raised (string what);
exception wrong (string what, poly got, poly want);

void function check (string what, poly got, poly want)
{
    if (got != want)
	raise wrong (what, got, want);
}

/* Results too large to represent raise out_of_memory */
void function too_large (string what, poly() f)
{
    try {
	f ();
	raise not_raised (what);
    } catch out_of_memory (string m) {
    }
}

too_large ("1 << 2**62", poly func () { return 1 << (2**62); });
too_large ("-3 << 2**70", poly func () { return -3 << (2**70); });
too_large ("2 ** 2**62", poly func () { return 2 ** (2**62); });
too_large ("(1/3) ** 2**62", poly func () { return (1/3) ** (2**62); });
too_large ("(-2) ** -2**62", poly func () { return (-2) ** -(2**62); });

/* Bases whose powers don't grow need no space */
check ("(-1) ** (2**62 + 1)", (-1) ** (2**62 + 1), -1);
check ("1 ** 2**70", 1 ** (2**70), 1);
check ("0 ** 2**70", 0 ** (2**70), 0);
check ("0 << 2**70", 0 << (2**70), 0);

/* Shifting out every bit leaves 0, or -1 for negative values */
check ("7 >> 2**31", 7 >> (2**31), 0);
check ("2**100 >> 2**80", (2**100) >> (2**80), 0);
check ("-5 >> 2**80", -5 >> (2**80), -1);
check ("-(2**100) >> 2**40", -(2**100) >> (2**40), -1);
check ("-(2**100) >> 99", -(2**100) >> 99, -2);
check ("2**100 << -(2**80)", (2**100) << -(2**80), 0);

/* Shift counts and bit counts past the small int range */
int big;
try {
    big = 1 << (2**30);
} catch out_of_memory (string m) {
    printf("system too small for large shift tests\n");
    exit(0);
}

check ("bit_width (1 << 2**30)", bit_width (big), 2**30 + 1);
check ("(1 << 2**30) >> (2**30 - 3)", big >> (2**30 - 3), 8);
check ("popcount ((1 << 2**30) - 1)", Math::popcount (big - 1), 2**30);
