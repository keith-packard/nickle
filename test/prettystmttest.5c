/*
 * Nickle test suite
 *
 * Printing union switch cases, raise statements, and declarations
 *
 * Union switch case labels printed blank, losing the member and the
 * name bound to its value, and raise of an exception qualified by a
 * namespace printed whatever followed the name's node. const ran into
 * its type, and global was dropped from declarations inside functions.
 * Uninitialized globals printed = <uninit>, and namespaces nested in a
 * printed namespace printed without their bodies. do-while printed a
 * stray semicolon, which broke an enclosing if-else, and a
 * comprehension block printed misindented.
 */

exception wrong (string what, poly got, poly want);

void function check (string what, poly got, poly want)
{
    if (got != want)
	raise wrong (what, got, want);
}

/* Return the printed form of the function 'name' */
string function printed (string name)
{
    file f = File::string_write ();
    Command::pretty_print (f, (string[*]) { name });
    return File::string_string (f);
}

void function has (string what, string text, string want)
{
    if (String::index (text, want) < 0)
	raise wrong (what, text, want);
}

typedef union { int i; string s; void v; } U;

int function pick (U u)
{
    union switch (u) {
    case i:
	return 1;
    case s x:
	return String::length (x);
    default:
	return 0;
    }
}

string p = printed ("pick");
has ("member", p, "case i:");
has ("bound name", p, "case s x:");

namespace N { public exception nx (); }

void function thrower ()
{
    raise N::nx ();
}

has ("qualified raise", printed ("thrower"), "raise N::nx ();");

/* The printed union switch compiles and behaves the same */
int start = String::index (p, "(");
string again = String::substr (p, start, String::length (p) - start);
Command::lex_string ("int function pick_again " + again + "\n" +
		     "check (\"i\", pick_again ((U) { .i = 5 }), pick ((U) { .i = 5 }));\n" +
		     "check (\"s\", pick_again ((U) { .s = \"abc\" }), 3);\n" +
		     "check (\"v\", pick_again (U.v), 0);\n");

/* Declaration qualifiers print with their types, and global persists */
int function quals ()
{
    const int c = 9;
    const k = 3;
    global int gg = 5;
    static int s = 2;
    return c + k + gg++ + s;
}

string q = printed ("quals");
has ("const", q, "const int c = 9;");
has ("const poly", q, "const k = 3;");
has ("global", q, "global int gg = 5;");
has ("static", q, "static int s = 2;");
int qstart = String::index (q, "(");
Command::lex_string ("int function quals_again " +
		     String::substr (q, qstart, String::length (q) - qstart) + "\n" +
		     "check (\"first call\", quals_again (), 19);\n" +
		     "check (\"second call\", quals_again (), 20);\n");

/* Printed globals and namespaces read back */
namespace Outer {
    public int x = 1;
    public namespace Inner {
	public int y = 2;
    }
}
int unset;

file nf = File::string_write ();
Command::pretty_print (nf, (string[*]) { "Outer" });
Command::pretty_print (nf, (string[*]) { "unset" });
string ns = File::string_string (nf);
has ("nested namespace", ns, "public namespace Inner {");
has ("uninitialized", ns, "global int unset;");
Command::lex_string ("namespace Again " + String::substr (ns, String::index (ns, "{"),
							  String::length (ns) - String::index (ns, "{")) +
		     "check (\"outer\", Again::x, 1);\n" +
		     "check (\"inner\", Again::Inner::y, 2);\n");

/* do-while inside if-else, and a comprehension with a block, read back */
int function dowhile (int a, bool b)
{
    if (b)
	do
	    a--;
	while (a > 0)
    else
	a = 5;
    return a;
}

int[*] function compblock ()
{
    return (int[3]) { [i] { int j = i * 2; return j + 1; } };
}

string dw = printed ("dowhile");
string cb = printed ("compblock");
has ("do-while", dw, "while (a > 0)\n");
int dws = String::index (dw, "(");
int cbs = String::index (cb, "(");
Command::lex_string ("int function dowhile_again " +
		     String::substr (dw, dws, String::length (dw) - dws) +
		     "int[*] function compblock_again " +
		     String::substr (cb, cbs, String::length (cb) - cbs) +
		     "check (\"do-while true\", dowhile_again (3, true), dowhile (3, true));\n" +
		     "check (\"do-while false\", dowhile_again (3, false), dowhile (3, false));\n" +
		     "check (\"comprehension\", compblock_again (), compblock ());\n");
