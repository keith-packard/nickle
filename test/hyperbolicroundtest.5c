/*
 * Nickle test suite
 *
 * sinh, cosh, and tanh are correctly rounded
 *
 * cosh computed (exp(x) + exp(-x)) / 2 at the precision of x, and sinh
 * and tanh carried a few more bits, so each was sometimes an ulp off
 */

exception bad_result (string name, real x, real got, real want);

void check (string name, real(real) f, real x, int prec)
{
    x = imprecise (x, prec);

    real	got = f (x);
    real	want = imprecise (f (imprecise (x, prec + 600)), prec);

    if (got != want)
	raise bad_result (name, x, got, want);
}

/* Arguments from 2**-40 to about 2**20, of both signs */
for (int k = 1; k <= 1200; k++) {
    rational	x = (k * 7919 % 10007) / 1009 * 2 ** (k % 61 - 40);

    if (k % 2 == 0)
	x = -x;
    for (int prec = 53; prec <= 113; prec += 60) {
	check ("sinh", sinh, x, prec);
	check ("cosh", cosh, x, prec);
	check ("tanh", tanh, x, prec);
    }
}

if (sinh (0) != 0 || cosh (0) != 1 || tanh (0) != 0)
    raise bad_result ("zero", 0, 0, 0);
