/*
 * Nickle test suite
 *
 * Precision of gamma near its poles and for large arguments
 *
 * The reflection formula computed sin(πn) from πn, which cancels
 * near the poles, losing about 25 bits at -3 + 1e-10. The asymptotic
 * series raised n/e to the power n with 20 guard bits, though that
 * multiplies its error by n, losing all bits of gamma(1e40). gamma
 * is now correctly rounded, so each result must equal a far more
 * precise one rounded to the same precision.
 */

exception bad_gamma (real x, real got, real want);

int[*] precs = { 53, 113 };
real[*] points = {
    -3 + 1e-10, -3 - 1e-12, -7.5, -0.25, 1e-30, 0.5, 2.5, 10.3, 9999.5,
    1e20 + 0.5, 1e40,
};

for (int i = 0; i < dim (points); i++)
    for (int j = 0; j < dim (precs); j++) {
	real x = imprecise (points[i], precs[j]);
	real got = gamma (x);
	real want = imprecise (gamma (imprecise (x, 512)), precs[j]);

	if (got != want)
	    raise bad_gamma (x, got, want);
    }
