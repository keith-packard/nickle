/*
 * Nickle test suite
 *
 * Exceptions declared in nickle code
 *
 * A declared exception's symbol had type poly instead of its function
 * type, so printing it read arguments from the wrong kind of type, and
 * raise and catch weren't checked against its arguments.
 */

exception wrong (string what, poly got, poly want);

void function check (string what, poly got, poly want)
{
    if (got != want)
	raise wrong (what, got, want);
}

exception e1 (int a, string b);

file f = File::string_write ();
Command::pretty_print (f, (string[*]) { "e1" });
check ("printed", File::string_string (f), "exception e1 (int a, string b);\n");

int got_a = 0;
string got_b = "";
try {
    raise e1 (1, "y");
} catch e1 (int a, string b) {
    got_a = a;
    got_b = b;
}
check ("caught a", got_a, 1);
check ("caught b", got_b, "y");
