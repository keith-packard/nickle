/*
 * Nickle test suite
 *
 * Opening more files than the soft limit allows
 *
 * Systems commonly start programs with a soft limit of 1024 open
 * files, so a script couldn't open more even when the hard limit
 * allowed it. Nickle waits for files with poll, which handles any
 * descriptor, so it raises the soft limit to the hard limit at
 * startup. Programs run through File::filter get the original limit
 * back, since they may use select.
 */

exception wrong (string what, poly got, poly want);

void function check (string what, poly got, poly want)
{
    if (got != want)
	raise wrong (what, got, want);
}

string	nickle = Environ::get ("NICKLE");

/*
 * Under a soft limit of 1024, print the hard limit, then run a child
 * nickle that opens 1100 files and has sh print the limit it sees
 */
string	script = ("file[1100] f = { [i] = File::open (\"/dev/null\", \"r\") };\n" +
		  "File::filter (\"sh\", (string[*]) { \"sh\", \"-c\", \"ulimit -n\" },\n" +
		  "              (file[3]) { stdin, stdout, stderr });\n");

file[*]	out = File::mkpipe ();

File::filter ("sh",
	      (string[*]) { "sh", "-c",
			    "ulimit -S -n 1024 || exit; ulimit -H -n; \"$0\" -e \"$1\"",
			    nickle, script },
	      (file[3]) { stdin, out[1], stderr });
File::close (out[1]);

string	hard = File::fgets (out[0]);

/* Skip when the hard limit leaves no room past 1100 */
if (hard == "unlimited" || string_to_integer (hard) >= 1100)
    check ("filtered limit", File::fgets (out[0]), "1024");
File::close (out[0]);
