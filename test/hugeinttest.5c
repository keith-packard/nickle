/*
 * Nickle test suite
 *
 * Very large integers
 *
 * Integer lengths and bit counts were ints, so results of 2³¹ bits
 * or more overflowed them, and the scratch space for multiplying
 * values of 2²⁹ bits overflowed its byte count, aborting with "Out
 * of memory". Shift counts too large for a small int went through **,
 * and results too large to represent at all were never detected.
 */

exception not_raised(string what);
exception wrong(string what, poly got, poly want);

void
check(string what, poly got, poly want)
{
    if (got ≠ want)
        raise wrong(what, got, want);
}

/* Results too large to represent raise out_of_memory */
void
too_large(string what, poly() f)
{
    try {
        f();
        raise not_raised(what);
    } catch out_of_memory(string m) {
    }
}

too_large("1 << 2**62", func() = 1 << (2⁶²));
too_large("-3 << 2**70", func() = -3 << (2⁷⁰));
too_large("2 ** 2**62", func() = 2 ** 2⁶²);
too_large("(1/3) ** 2**62", func() = (1 / 3) ** 2⁶²);
too_large("(-2) ** -2**62", func() = -2 ** -(2⁶²));

/* Bases whose powers don't grow need no space */
check("(-1) ** (2**62 + 1)", -1 ** (2⁶² + 1), -1);
check("1 ** 2**70", 1 ** 2⁷⁰, 1);
check("0 ** 2**70", 0 ** 2⁷⁰, 0);
check("0 << 2**70", 0 << (2⁷⁰), 0);

/* Shifting out every bit leaves 0, or -1 for negative values */
check("7 >> 2**31", 7 >> (2³¹), 0);
check("2**100 >> 2**80", (2¹⁰⁰) >> (2⁸⁰), 0);
check("-5 >> 2**80", -5 >> (2⁸⁰), -1);
check("-(2**100) >> 2**40", -(2¹⁰⁰) >> (2⁴⁰), -1);
check("-(2**100) >> 99", -(2¹⁰⁰) >> 99, -2);
check("2**100 << -(2**80)", (2¹⁰⁰) << -(2⁸⁰), 0);

/* Shift counts and bit counts past the small int range */
int big;
try {
    big = 1 << (2³⁰);
} catch out_of_memory(string m) {
    printf("system too small for large shift tests\n");
    exit(0);
}

check("bit_width (1 << 2**30)", bit_width(big), 2³⁰ + 1);
check("(1 << 2**30) >> (2**30 - 3)", big >> (2³⁰ - 3), 8);
check("popcount ((1 << 2**30) - 1)", Math::popcount(big - 1), 2³⁰);
