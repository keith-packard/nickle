/*
 * Nickle test suite
 *
 * Socket::string_to_addr and addr_to_string
 *
 * string_to_addr took any four integers, so "256.1.1.1" gave
 * 0.1.1.1 and "1.2.-1.4" gave 1.1.255.4, and it ignored trailing
 * text; addr_to_string masked addresses outside 32 bits
 */

exception bad_addr (string what, poly value);

string[*][2] good = {
    { "1.2.3.4", "1.2.3.4" }, { "0.0.0.0", "0.0.0.0" },
    { "255.255.255.255", "255.255.255.255" },
    { "010.1.1.1", "10.1.1.1" }, { "127.0.0.1", "127.0.0.1" },
};

for (int i = 0; i < dim (good); i++) {
    string	got = Socket::addr_to_string (Socket::string_to_addr (good[i][0]));

    if (got != good[i][1])
	raise bad_addr (good[i][0], got);
}

if (Socket::string_to_addr ("1.2.3.4") != 0x01020304)
    raise bad_addr ("1.2.3.4", Socket::string_to_addr ("1.2.3.4"));

string[*] bad = {
    "256.1.1.1", "1.2.-1.4", "1.2.3.4x", " 1.2.3.4", "1.2.3.4.5",
    "+1.2.3.4", "1.2.3", "1..3.4", "0010.1.1.1", "", "a.b.c.d",
};

for (int i = 0; i < dim (bad); i++) {
    try {
	Socket::string_to_addr (bad[i]);
	raise bad_addr ("accepted", bad[i]);
    } catch invalid_argument (string msg, int arg, poly value) {
    }
}

int[*] out_of_range = { -1, 2**32, -(2**40) };

for (int i = 0; i < dim (out_of_range); i++) {
    try {
	Socket::addr_to_string (out_of_range[i]);
	raise bad_addr ("printed", out_of_range[i]);
    } catch invalid_argument (string msg, int arg, poly value) {
    }
}
