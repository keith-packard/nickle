/*
 * Nickle test suite
 *
 * Growing a resizable array after shrinking it
 *
 * Shrinking an array to less than half its storage kept the values
 * past the new limit, so growing it again brought them back instead of
 * uninitialized elements, and emptying one dimension of an array emptied
 * them all.
 */

exception wrong (string what, poly got, poly want);

void function check (string what, poly got, poly want)
{
    if (got != want)
	raise wrong (what, got, want);
}

int[...] a = { 1, 2, 3, 4, 5, 6, 7, 8 };
setdim (a, 3);
setdim (a, 4);
check ("1-d kept", a[2], 3);
check ("1-d cleared", is_uninit (&a[3]), true);

/* Shrink each dimension of a two-dimensional array */
int[...,...] b = {};
setdims (b, (int[*]) { 2, 8 });
for (int i = 0; i < 2; i++)
    for (int j = 0; j < 8; j++)
	b[i,j] = i * 10 + j;
setdims (b, (int[*]) { 2, 3 });
setdims (b, (int[*]) { 2, 4 });
check ("inner kept", b[1,2], 12);
check ("inner cleared", is_uninit (&b[1,3]), true);

int[...,...] c = {};
setdims (c, (int[*]) { 8, 2 });
for (int i = 0; i < 8; i++)
    for (int j = 0; j < 2; j++)
	c[i,j] = i * 10 + j;
setdims (c, (int[*]) { 3, 2 });
setdims (c, (int[*]) { 4, 2 });
check ("outer kept", c[2,1], 21);
check ("outer cleared", is_uninit (&c[3,0]), true);

/* Emptying one dimension keeps the others' sizes */
int[...,...] e = {};
setdims (e, (int[*]) { 2, 3 });
e[1,2] = 7;
setdims (e, (int[*]) { 0, 3 });
check ("emptied rows", dims (e), (int[*]) { 0, 3 });
setdims (e, (int[*]) { 2, 3 });
check ("regrown rows", is_uninit (&e[1,2]), true);
setdims (e, (int[*]) { 2, 0 });
check ("emptied columns", dims (e), (int[*]) { 2, 0 });
