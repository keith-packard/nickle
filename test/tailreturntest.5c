/*
 * Nickle test suite
 *
 * A tail call checks the value it returns
 *
 * A function value need only have a type ordered with the type it's
 * stored as, so an int(int) can hold a function returning rational.
 * The compiler makes 'return f (x)' a tail call when f's static return
 * type fits, which skipped the caller's check of the value it returned,
 * so an int function could return 1/3.
 */

exception wrong (string what, poly got, poly want);

void function check (string what, poly got, poly want)
{
    if (got != want)
	raise wrong (what, got, want);
}

/* Call 'f', returning the message of an invalid_argument it raises */
poly function result (poly() f)
{
    try {
	return f ();
    } catch invalid_argument (string msg, int i, poly value) {
	return msg;
    }
}

int(int) third = rational func (int x) { return x / 3; };
int(int) twice = poly func (int x) { return x * 2; };
int(int) word = poly func (int x) { return "s"; };

int function call (int(int) f, int x)
{
    return f (x);
}

check ("rational", result (func () { return call (third, 1); }), "Incompatible type in return");
check ("rational that fits", result (func () { return call (third, 3); }), 1);
check ("poly", result (func () { return call (twice, 2); }), 4);
check ("string", result (func () { return call (word, 1); }), "Incompatible type in return");

/* A poly function returns whatever its callee does */
poly function pass (int(int) f, int x)
{
    return f (x);
}

check ("poly caller", pass (third, 1), 1/3);

/* Tail calls still run in constant space */
int function count (int n)
{
    if (n == 0)
	return 0;
    return count (n - 1);
}

check ("tail recursion", count (1000000), 0);

/*
 * A void call that ends a function of another type isn't a tail call,
 * which hid that the function could reach its end and return <>
 */
string[*] read_lines (file f)
{
    string[...]	lines = {};

    while (!File::end (f))
	lines[dim (lines)] = File::fgets (f);
    return lines;
}

string	nickle = Environ::get ("NICKLE");
file[*]	errors = File::mkpipe ();

File::filter (nickle,
	      (string[*]) { nickle, "-e",
			    "void g () { }\nint f () { g (); }\n" },
	      (file[3]) { stdin, stdout, errors[1] });
File::close (errors[1]);

string[*]	err = read_lines (errors[0]);
bool		reported = false;

for (int i = 0; i < dim (err); i++)
    if (String::index (err[i], "Control reaches end of function with type 'int'") >= 0)
	reported = true;
check ("void call ending int function", reported, true);

/* Process::popen ends in abort, now noreturn, so it still compiles */
autoload Process
file echo = Process::popen (Process::popen_direction.read, true, "echo", "echo", "hi");
check ("popen", File::fgets (echo), "hi");
File::close (echo);
