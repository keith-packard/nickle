/*
 * Nickle test suite
 *
 * Newlines inside brackets after a lookahead
 *
 * A top-level if without an else reads the next command's first token,
 * looking for the else. When that token opens a parenthesis or a
 * brace, newlines inside it still don't end the command.
 */

int	x = 0;

if (x > 0)
    x = 1;
(int	y =
     2);

if (x > 0)
    x = 1;
{
    x = 3;
}

if (y != 2 || x != 3)
    exit (1);
