                 (file[3]) { stdin, out[1], out[1] });
    File::close(out[1]);

    string got = "";
    while (!File::end(out[0]))
        got += File::fgets(out[0]) + "\n";
    File::close(out[0]);
    File::unlink(first);
    File::unlink(second);
    return got;
