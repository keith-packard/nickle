extend namespace Math {

    int small_bits(real x)
	/*
	 * Returns the number of bits lost to cancellation when 'x',
	 * a difference from 1 or 0, is small
	 */
    {
	int e = exponent(imprecise(x));
	return e < 0 ? -e : 0;
    }

    real exact_one_plus(real x)
	/*
	 * Returns 1 + 'x' exactly
	 */
    {
	x = imprecise(x);
	return imprecise(x, precision(x) + abs(exponent(x)) + 2) + 1;
    }

    protected real asinh_w(real v, int wprec, *real err)
	/*
	 * Compute asinh(v) to 'wprec' bits, setting 'err' to a bound on
	 * the absolute error. asinh(0) is an exact 0
	 */
    {
	if (v == 0) {
	    *err = 0;
	    return 0;
	}

	/*
	 * asinh(s) = log1p(s + s**2 / (1 + sqrt(s**2 + 1))) for
	 * s = |v|, whose terms are all positive. Rounding s and the
	 * steps leave t under 10 roundings from exact, plus the
	 * square root's error, and log1p' = 1 / (1 + t)
	 */
	real	u = 2**-wprec;
	real	s = imprecise(abs(v), wprec);
	real	r_rel;
	real	r = sqrt_w(s * s + 1, wprec, &r_rel);
	real	t = s + s * s / (1 + r);
	real	t_rel = 10 * u + r_rel;
	real	l = log1p_w(t, wprec, err);

	*err += 2 * t * t_rel / (1 + t);
	if (v < 0)
	    return -l;
	return l;
    }

    protected real acosh_w(real x, int wprec, *real err)
	/*
	 * Compute acosh(x), x >= 1, to 'wprec' bits, setting 'err' to a
	 * bound on the absolute error. acosh(1) is an exact 0
	 */
    {
	if (x == 1) {
	    *err = 0;
	    return 0;
	}

	/*
	 * acosh(x) = log1p(t + sqrt(t (t + 2))) for t = x - 1, formed
	 * exactly and then rounded, as it cancels near 1. The terms
	 * are positive, leaving a under 6 roundings from exact, plus
	 * the square root's error
	 */
	real	u = 2**-wprec;
	real	t = imprecise(-exact_one_plus(-x), wprec);
	real	r_rel;
	real	r = sqrt_w(t * (t + 2), wprec, &r_rel);
	real	a = t + r;
	real	a_rel = 6 * u + r_rel;
	real	l = log1p_w(a, wprec, err);

	*err += 2 * a * a_rel / (1 + a);
	return l;
    }

    protected real atanh_w(real x, int wprec, *real err)
	/*
	 * Compute atanh(x), |x| < 1, to 'wprec' bits, setting 'err' to a
	 * bound on the absolute error. atanh(0) is an exact 0
	 */
    {
	if (x == 0) {
	    *err = 0;
	    return 0;
	}

	/*
	 * atanh(s) = log1p(2s / (1 - s)) / 2 for s = |x|. Rounding s,
	 * and 1 - s, formed exactly, leave q under 3 roundings from
	 * exact, and log1p' <= 1 for q >= 0
	 */
	real	u = 2**-wprec;
	real	s = imprecise(abs(x), wprec);
	real	q = 2 * s / imprecise(exact_one_plus(-s), wprec);
	real	l = log1p_w(q, wprec, err);

	*err = (*err + 4 * q * u) / 2;
	if (x < 0)
	    return -l / 2;
	return l / 2;
    }

    public real acosh(x)
	/*
	 * Returns inverse hyperbolic cosine of 'x'.
	 */
    {
	if (x < 1)
	    raise invalid_argument("acosh arg < 1", 0, x);
	/* Keep the precision of an imprecise 1 */
	if (x == 1)
	    return x - 1;
	x = imprecise(x);
	real compute(int wprec, *real err)
	{
	    return acosh_w(x, wprec, err);
	}

	return round_correctly(precision(x), compute);
    }

    public real asinh(x)
	/*
	 * Returns inverse hyperbolic sine of 'x'.
	 */
    {
	/* Keep the precision of an imprecise 0 */
	if (x == 0)
	    return x;
	x = imprecise(x);
	real compute(int wprec, *real err)
	{
	    return asinh_w(x, wprec, err);
	}

	return round_correctly(precision(x), compute);
    }

    public real atanh(x)
	/*
	 * Returns inverse hyperbolic tangent of 'x'.
	 */
    {
	if (abs(x) > 1)
	    raise invalid_argument("atanh arg > 1", 0, x);
	if (abs(x) == 1)
	    raise divide_by_zero(x, 0);
	if (x == 0)
	    return x;
	x = imprecise(x);
	real compute(int wprec, *real err)
	{
	    return atanh_w(x, wprec, err);
	}

	return round_correctly(precision(x), compute);
    }

    protected real cosh_w(real x, int wprec, *real rel)
	/*
	 * Compute cosh(x) to 'wprec' bits, setting 'rel' to a bound on
	 * the relative error. cosh(0) is an exact 1
	 */
    {
	if (x == 0) {
	    *rel = 0;
	    return 1;
	}

	real	r;
	real	e = exp_w(abs(x), wprec, &r);

	/* 1/e and the sum of positive terms each add a rounding */
	*rel = r + 3 * 2**-wprec;
	return (e + 1 / e) / 2;
    }

    protected real sinh_w(real x, int wprec, *real rel)
	/*
	 * Compute sinh(x) to 'wprec' bits, setting 'rel' to a bound on
	 * the relative error. sinh(0) is an exact 0
	 */
    {
	if (x == 0) {
	    *rel = 0;
	    return 0;
	}

	/*
	 * e - 1/e cancels as x approaches 0, losing small_bits(x)
	 * bits, so compute e with that many more
	 */
	int	eprec = wprec + small_bits(x) + 2;
	real	ue = 2**-eprec;
	real	r;
	real	e = exp_w(abs(x), eprec, &r);
	real	s = (e - 1 / e) / 2;

	/*
	 * e and 1/e carry absolute errors under (r + ue) e and
	 * (r + 2 ue) / e, and the difference rounds once more
	 */
	*rel = ((r + 2 * ue) * (e + 1 / e) + ue * s) / s;
	if (x < 0)
	    return -s;
	return s;
    }

    public real cosh(x)
	/*
	 * Returns hyperbolic cosine of 'x'.
	 */
    {
	if (x == 0)
	    return 1;
	x = imprecise(x);
	real compute(int wprec, *real err)
	{
	    real	rel;
	    real	c = cosh_w(x, wprec, &rel);

	    *err = c * rel;
	    return c;
	}

	return round_correctly(precision(x), compute);
    }

    public real sinh(x)
	/*
	 * Returns hyperbolic sine of 'x'.
	 */
    {
	/* Keep the precision of an imprecise 0 */
	if (x == 0)
	    return x;
	x = imprecise(x);
	real compute(int wprec, *real err)
	{
	    real	rel;
	    real	s = sinh_w(x, wprec, &rel);

	    *err = abs(s) * rel;
	    return s;
	}

	return round_correctly(precision(x), compute);
    }

    public real tanh(x)
	/*
	 * Returns hyperbolic tangent of 'x'.
	 */
    {
	if (x == 0)
	    return x;
	x = imprecise(x);
	real compute(int wprec, *real err)
	{
	    real	srel, crel;
	    real	t = sinh_w(x, wprec, &srel) / cosh_w(x, wprec, &crel);

	    /* The quotient adds one rounding */
	    *err = abs(t) * (2 * (srel + crel) + 2**-wprec);
	    return t;
	}

	return round_correctly(precision(x), compute);
    }

    real _erf(real x, real off)
    {
	x = imprecise(x);
	int bits = precision(x);
	/*
	 * The terms grow to about e**(x*x) before they cancel, and
	 * erfc(x) shrinks to about e**-(x*x), so carry enough bits
	 * for both, log2(e) being under 1.45
	 */
	int loss = ceil(imprecise(x, 64) ** 2 * 1.45);
	if (off != 0)
	    loss *= 2;
	int obits = bits + loss + 64;
	real factor = 2 / sqrt(pi_value(obits));

	x = imprecise(x, obits);
	real x2 = x * x;
	real t = x;
	real val = x - imprecise(off, obits) / factor;

	for (int n = 1; ; n++) {
	    /* t is (-1)**n * x**(2n+1) / n! */
	    t = -t * x2 / n;
	    real a = t / (2 * n + 1);
	    val += a;
	    if (a == 0 || exponent(val) - exponent(a) > obits)
		break;
	}
	return imprecise(val * factor, bits);
    }

    public real erf(real x)
	/*
	 * Returns Gauss error function of 'x'.
	 */
    {
	return _erf(x, 0);
    }

    public real erfc(real x)
	/*
	 * Returns Gauss complementary error function of 'x'.
	 */
    {
	return -_erf(x, 1);
    }

    /*
     * log2(e), converting the e**x growth of the terms in the Bessel
     * power series into the number of bits lost to cancellation
     */
    real log2_e = 1 / log(imprecise(2, 64));

    public real euler_gamma_value(int prec)
	/*
	 * Returns the Euler-Mascheroni constant at least as precise as 'prec'
	 */
    {
	static real local_gamma = 0;

	if (local_gamma == 0 || precision(local_gamma) < prec) {
	    /*
	     * Brent-McMillan algorithm B1, error is O(e**(-4n))
	     *
	     * R. P. Brent and E. M. McMillan, "Some new algorithms for
	     * high-precision computation of Euler's constant",
	     * Math. Comp. 34 (1980), 305-312
	     * https://www.ams.org/mcom/1980-34-149/S0025-5718-1980-0551307-4/
	     *
	     * Grow by at least half again, so slowly rising precisions
	     * reuse the value
	     */
	    int	grown = precision(local_gamma) * 3 // 2;
	    int	wprec = max(prec, grown) + 32;
	    int	n = wprec // 5 + 1;
	    int	n2 = n * n;
	    real a = -log(imprecise(n, wprec));
	    real b = imprecise(1, wprec);
	    real u = a;
	    real v = b;

	    for (int k = 1; ; k++) {
		b = b * n2 / (k * k);
		a = (a * n2 / k + b) / k;
		u += a;
		v += b;
		if (k > n &&
		    exponent(v) - exponent(b) > wprec &&
		    exponent(u) - exponent(a) > wprec)
		    break;
	    }
	    local_gamma = imprecise(u / v, wprec);
	}
	return imprecise(local_gamma, prec);
    }

    real _yn_series(int n, real x, int obits, *int err)
	/*
	 * Power series for Yn (Abramowitz & Stegun 9.1.11):
	 *
	 * Yn(x) = (2/π) (log(x/2) + γ) Jn(x)
	 *	   - (1/π) (x/2)**-n Σ{k=0..n-1} (n-k-1)!/k! (x/2)**2k
	 *	   - (1/π) (x/2)**n Σ{k=0..} (Hk + Hn+k) (-(x/2)**2)**k /
	 *					     (k! (n+k)!)
	 *
	 * where Hk + Hn+k - 2γ = ψ(k+1) + ψ(n+k+1) turns the digamma
	 * form of the series into harmonic numbers
	 *
	 * https://en.wikipedia.org/wiki/Bessel_function
	 *	("Bessel functions of the second kind")
	 * https://en.wikipedia.org/wiki/Digamma_function
	 *
	 * The infinite sum suffers cancellation for large x; the
	 * caller must supply sufficient extra precision in 'obits'.
	 * Sets 'err' so that the absolute error is below 2**err
	 */
    {
	real	x_2 = x / 2;
	real	x_2_2 = x_2 * x_2;

	real	fin = imprecise(0, obits);
	if (n > 0) {
	    real ft = imprecise((n-1)!, obits);
	    for (int k = 0; k < n; k++) {
		fin += ft;
		if (k + 1 < n)
		    ft = ft * x_2_2 / ((k + 1) * (n - k - 1));
	    }
	}

	real	t = x_2 ** n / n!;
	real	hk = imprecise(0, obits);
	real	hnk = imprecise(0, obits);
	for (int j = 1; j <= n; j++)
	    hnk += 1/j;

	real	jsum = imprecise(0, obits);
	real	hsum = imprecise(0, obits);
	real	jabs = imprecise(0, obits);
	real	habs = imprecise(0, obits);
	int	lim = exponent(t) - obits;
	int	k;

	for (k = 0; ; ) {
	    real ht = (hk + hnk) * t;
	    jsum += t;
	    hsum += ht;
	    jabs += abs(t);
	    habs += abs(ht);
	    if (exponent(t) > lim + obits)
		lim = exponent(t) - obits;
	    if (k > x_2 && exponent(t) < lim && exponent(ht) < lim)
		break;
	    k++;
	    hk += 1/k;
	    hnk += 1/(n+k);
	    t = t * -x_2_2 / (k * (n + k));
	}

	real	l = log(x_2) + euler_gamma_value(obits);
	real	fx = fin / x_2 ** n;

	/*
	 * Each term carries fewer than 3k + 2n rounding errors and each
	 * sum k more, all relative to the sums of absolute values; the
	 * harmonic numbers, log and γ add a few more
	 */
	real	mag = (2 * abs(l) + 4) * jabs + habs + fx;
	*err = exponent(mag * (6 * k + 3 * n + 16)) - obits + 1;
	return (2 * l * jsum - hsum - fx) / pi_value(obits);
    }

    typedef struct {
	real	p, q;
	real	sin_chi, cos_chi;
	int	err;
    } hankel_t;

    bool _hankel_pq(int n, real x, int obits, *hankel_t h)
	/*
	 * Hankel asymptotic series (Abramowitz & Stegun 9.2.9, 9.2.10):
	 *
	 * P(n,x) = Σ{k=0..} (-1)**k a2k(n) / x**2k
	 * Q(n,x) = Σ{k=0..} (-1)**k a2k+1(n) / x**(2k+1)
	 * ak(n) = (4n**2 - 1**2) (4n**2 - 3**2) ... (4n**2 - (2k-1)**2) /
	 *	   (k! 8**k)
	 * χ = x - (n/2 + 1/4) π
	 *
	 * H. Hankel, "Die Cylinderfunctionen erster und zweiter Art",
	 * Math. Ann. 1 (1869), 467-501
	 * https://link.springer.com/article/10.1007/BF01445870
	 *
	 * Returns P, Q, sin χ and cos χ along with 'err' such that
	 * P and Q combined with sin χ and cos χ have absolute error
	 * below 2**err, or false if the series diverges before reaching
	 * 'obits' of precision
	 */
    {
	int	mu = 4 * n * n;
	real	x8 = 8 * x;
	real	t = imprecise(1, obits);
	real	p = t;
	real	q = imprecise(0, obits);
	real	tabs = t;
	int	k;

	for (k = 1; ; k++) {
	    int	f = mu - (2 * k - 1) ** 2;
	    real r = f / (k * x8);
	    if (f < 0 && abs(r) >= 1)
		return false;
	    t *= r;
	    tabs += abs(t);
	    switch (k % 4) {
	    case 0: p += t; break;
	    case 1: q += t; break;
	    case 2: p -= t; break;
	    case 3: q -= t; break;
	    }
	    if (k > n && exponent(t) < -obits)
		break;
	}

	/*
	 * With k > n, the remainders of P and Q are each below their
	 * first omitted terms, k+1 and k+2 (Hankel, pp. 491-494; G. N.
	 * Watson, "A Treatise on the Theory of Bessel Functions" (1922),
	 * §7.3, https://archive.org/details/treatiseontheory00watsuoft)
	 */
	real	t1 = t * (mu - (2 * k + 1) ** 2) / ((k + 1) * x8);
	real	t2 = t1 * (mu - (2 * k + 3) ** 2) / ((k + 2) * x8);

	/* Reduce χ using enough bits of π to cover the magnitude of x */
	int	cbits = obits + max(exponent(x), 0);
	real	pi_c = pi_value(cbits);
	real	chi = imprecise(x, cbits) - (2 * n + 1) / 4 * pi_c;
	chi = imprecise(chi % (2 * pi_c), obits);

	real	s, c;
	sin_cos(chi, &s, &c);

	/*
	 * Term k carries fewer than 2k rounding errors and each sum k
	 * more, relative to the sum of absolute values. χ is good to
	 * about 2**(4-obits), perturbing sin χ and cos χ by as much
	 */
	real	round = (3 * k + 2) * tabs + 32 * (abs(p) + abs(q)) + 4;
	real	bound = round * 2 ** -obits + abs(t1) + abs(t2);
	*h = (hankel_t) { .p = p, .q = q, .sin_chi = s, .cos_chi = c,
			  .err = exponent(bound) + 1 };
	return true;
    }

    bool _jn_asymptotic(int n, real x, int obits, *real result, *int err)
	/*
	 * Hankel asymptotic expansion for Jn (Abramowitz & Stegun 9.2.5):
	 *
	 * Jn(x) = sqrt(2/(πx)) (P(n,x) cos χ - Q(n,x) sin χ)
	 *
	 * Sets 'err' so that the absolute error is below 2**err, or
	 * returns false if the series diverges before reaching 'obits'
	 * of precision
	 */
    {
	hankel_t	h;

	if (!_hankel_pq(n, x, obits, &h))
	    return false;
	real	a = sqrt(2 / (pi_value(obits) * x));
	*result = a * (h.p * h.cos_chi - h.q * h.sin_chi);
	*err = h.err + exponent(a) + 1;
	return true;
    }

    bool _yn_asymptotic(int n, real x, int obits, *real result, *int err)
	/*
	 * Hankel asymptotic expansion for Yn (Abramowitz & Stegun 9.2.6):
	 *
	 * Yn(x) = sqrt(2/(πx)) (P(n,x) sin χ + Q(n,x) cos χ)
	 *
	 * Sets 'err' so that the absolute error is below 2**err, or
	 * returns false if the series diverges before reaching 'obits'
	 * of precision
	 */
    {
	hankel_t	h;

	if (!_hankel_pq(n, x, obits, &h))
	    return false;
	real	a = sqrt(2 / (pi_value(obits) * x));
	*result = a * (h.p * h.sin_chi + h.q * h.cos_chi);
	*err = h.err + exponent(a) + 1;
	return true;
    }

    real _jn_series(int n, real x, int obits, *int err)
	/*
	 * Power series for Jn (Abramowitz & Stegun 9.1.10):
	 *
	 * Jn(x) = (x/2)**n Σ{k=0..} (-(x/2)**2)**k / (k! (n+k)!)
	 *
	 * https://en.wikipedia.org/wiki/Bessel_function
	 *	("Bessel functions of the first kind")
	 *
	 * The sum suffers cancellation for large x; the caller
	 * must supply sufficient extra precision in 'obits'.
	 * Sets 'err' so that the absolute error is below 2**err
	 */
    {
	real	x_2 = x / 2;
	real	x_2_2 = x_2 * x_2;
	real	t = x_2 ** n / n!;
	real	val = imprecise(0, obits);
	real	vabs = imprecise(0, obits);
	int	lim = exponent(t) - obits;
	int	k;

	for (k = 0; ; ) {
	    val += t;
	    vabs += abs(t);
	    if (exponent(t) > lim + obits)
		lim = exponent(t) - obits;
	    if (k > x_2 && exponent(t) < lim)
		break;
	    k++;
	    t = t * -x_2_2 / (k * (n + k));
	}

	/*
	 * Each term carries fewer than 3k + 2n rounding errors and the
	 * sum k more, all relative to the sum of absolute values
	 */
	*err = exponent(vabs * (4 * k + 2 * n + 8)) - obits + 1;
	return val;
    }

    int _bessel_shortfall(real v, int err, int bits)
	/*
	 * Returns how many more bits of working precision are needed
	 * for 'v', whose absolute error is below 2**err, to be good to
	 * 'bits' bits, or 0 if it already is
	 */
    {
	if (v == 0)
	    return bits;
	return max(bits + 2 - (exponent(v) - err), 0);
    }

    public real jn(int n, real x)
	/*
	 * Returns Bessel function of the first kind, order 'n' of 'x'
	 */
    {
	/*
	 * J-n(x) = (-1)**n Jn(x)
	 * https://en.wikipedia.org/wiki/Bessel_function
	 */
	if (n < 0) {
	    real v = jn(-n, x);
	    if (n % 2 == 1)
		v = -v;
	    return v;
	}

	x = imprecise(x);
	int bits = precision(x);

	if (x == 0)
	    return imprecise(n == 0 ? 1 : 0, bits);
	/* Jn(-x) = (-1)**n Jn(x), the series terms are x**(n+2k) */
	if (x < 0) {
	    real v = jn(n, -x);
	    if (n % 2 == 1)
		v = -v;
	    return v;
	}

	/*
	 * Start with 32 bits beyond the target and retry with more
	 * when the error bound shows the result falls short, as it
	 * does near a zero of Jn
	 */
	int obits = bits + 32;

	for (;;) {
	    real v;
	    int	err;

	    /* Asymptotic series reaches about e**(-2x); try it for large x */
	    if (!(x > obits * 0.3 && 4 * n * n < 8 * x &&
		  _jn_asymptotic(n, imprecise(x, obits), obits, &v, &err))) {
		/* Power series loses about x * log2(e) bits to cancellation */
		int sbits = obits + ceil(x * log2_e);
		v = _jn_series(n, imprecise(x, sbits), sbits, &err);
	    }

	    int more = _bessel_shortfall(v, err, bits);
	    if (more == 0)
		return imprecise(v, bits);
	    obits += more + 8;
	}
    }

    public real j0(real x)
	/*
	 * Returns Bessel function of the first kind, order '0' of 'x'
	 */
    {
	return jn(0, x);
    }

    public real j1(real x)
	/*
	 * Returns Bessel function of the first kind, order '1' of 'x'
	 */
    {
	return jn(1, x);
    }

    public real yn(int n, real x)
	/*
	 * Returns Bessel function of the second kind, order 'n' of 'x'
	 */
    {
	/*
	 * Y-n(x) = (-1)**n Yn(x)
	 * https://en.wikipedia.org/wiki/Bessel_function
	 */
	if (n < 0) {
	    real v = yn(-n, x);
	    if (n % 2 == 1)
		v = -v;
	    return v;
	}

	if (x < 0)
	    raise invalid_argument("yn of negative value", 1, x);
	if (x == 0)
	    raise divide_by_zero(-1, 0);

	x = imprecise(x);
	int bits = precision(x);
	/*
	 * Start with 32 bits beyond the target and retry with more
	 * when the error bound shows the result falls short, as it
	 * does near a zero of Yn
	 */
	int obits = bits + 32;

	for (;;) {
	    real v;
	    int	err;

	    /* Asymptotic series reaches about e**(-2x); try it for large x */
	    if (!(x > obits * 0.3 && 4 * n * n < 8 * x &&
		  _yn_asymptotic(n, imprecise(x, obits), obits, &v, &err))) {
		/* Power series loses about x * log2(e) bits to cancellation */
		int sbits = obits + ceil(x * log2_e);
		v = _yn_series(n, imprecise(x, sbits), sbits, &err);
	    }

	    int more = _bessel_shortfall(v, err, bits);
	    if (more == 0)
		return imprecise(v, bits);
	    obits += more + 8;
	}
    }

    public real y0(real x)
	/*
	 * Returns Bessel function of the second kind, order '0' of 'x'
	 */
    {
	return yn(0, x);
    }

    public real y1(real x)
	/*
	 * Returns Bessel function of the second kind, order '1' of 'x'
	 */
    {
	return yn(1, x);
    }
}
