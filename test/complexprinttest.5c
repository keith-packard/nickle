/*
 * Nickle test suite
 *
 * Printing complex numbers as a+bi
 *
 * Complex numbers printed as a+ib, with any sign after the i and a
 * zero real part shown, as 0+i1.414213562373095 and 1.5+i-2.
 */

exception wrong (string what, poly got, poly want);

void function check (string what, poly got, poly want)
{
    if (got != want)
	raise wrong (what, got, want);
}

check ("pure imaginary", sprintf ("%g", Complex::sqrt (-2)), "1.414213562373095i");
check ("negative imaginary", sprintf ("%g", Complex::cmplx (1.5, -2)), "1.5-2i");
check ("both", sprintf ("%g", Complex::cmplx (1/3, 2)), "0.333333333333333+2i");
check ("negative pure", sprintf ("%g", Complex::cmplx (0, -2)), "-2i");
check ("imprecise zero real", sprintf ("%g", Complex::cmplx (imprecise (0), 1)), "0+1i");
check ("arbitrary precision", sprintf ("%.-g", Complex::cmplx (1/3, -1/7)), "0.{3}-0.{142857}i");
check ("%v", sprintf ("%v", Complex::cmplx (1.5, -2)), "cmplx((3/2), -2)");
