extend namespace Complex {
    protected complex(real r, real i) new = cmplx;

    protected complex i = new(0,1);

    /* Bits computed beyond the result precision */
    int	guard_bits = 32;

    int part_precision(complex z)
	/*
	 * Return the precision of 'z' from its imprecise parts, as
	 * arithmetic gives an exact operand the other's precision, or
	 * the default precision when both are exact. That is the
	 * precision of imprecise(0), which, unlike imprecise(z), costs
	 * nothing to compute
	 */
    {
	int	px = precision(creal(z)), py = precision(cimag(z));

	if (px == 0 && py == 0)
	    return precision(imprecise(0));
	return max(px, py);
    }

    complex round_correctly(int prec, complex(int, *real, *real) compute)
	/*
	 * As Math::round_correctly, for each part of the value from
	 * compute(wprec, &re_err, &im_err). A part with no error must
	 * be exact; an exact zero stays exact
	 */
    {
	bool round_part(real v, real err, int wprec, *real r)
	{
	    if (err == 0 && v == 0) {
		*r = 0;
		return true;
	    }

	    /*
	     * Form v ± err with the bits of both, as arithmetic would
	     * use the fewer, widening err by an ulp of v for the
	     * rounding of the sum
	     */
	    int		vp = max(precision(v), precision(err), wprec);
	    real	vw = imprecise(v, vp);
	    real	e = imprecise(err, vp) + Math::abs(vw) * 2**(1 - vp);

	    *r = imprecise(vw - e, prec);
	    return *r == imprecise(vw + e, prec);
	}

	for (int guard = guard_bits; ; guard *= 2) {
	    int		wprec = prec + guard;
	    real	re_err, im_err, re, im;
	    complex	v = compute(wprec, &re_err, &im_err);

	    if (round_part(creal(v), re_err, wprec, &re) &&
		round_part(cimag(v), im_err, wprec, &im))
		return new(re, im);
	}
    }

    real mul_err(real a, real a_err, real b, real b_err, int wprec)
	/*
	 * Return a bound on the error in a * b rounded to 'wprec' bits,
	 * given the errors in 'a' and 'b'
	 */
    {
	return Math::abs(a) * b_err + Math::abs(b) * a_err + a_err * b_err +
	       2 * Math::abs(a * b) * 2**-wprec;
    }

    real div_err(real n, real n_err, real d, real d_err, int wprec)
	/*
	 * Return a bound on the error in n / d rounded to 'wprec' bits,
	 * given the errors in 'n' and 'd'
	 */
    {
	if (n == 0 && n_err == 0)
	    return 0;

	real	q = Math::abs(n / d);

	/* Too uncertain to bound; ask for more bits */
	if (Math::abs(d) <= 2 * d_err)
	    return q + 1;
	return (n_err + q * d_err) / (Math::abs(d) - d_err) + 2 * q * 2**-wprec;
    }

    real twice_sum_squares(real a, real a_err, real b, real b_err, int wprec,
			   *real err)
	/*
	 * Return 2 (a² + b²) rounded to 'wprec' bits, setting 'err' to a
	 * bound on its error given the errors in 'a' and 'b'
	 */
    {
	real	s = a * a + b * b;

	*err = 2 * (mul_err(a, a_err, a, a_err, wprec) +
		    mul_err(b, b_err, b, b_err, wprec) + 2 * s * 2**-wprec);
	return 2 * s;
    }

    public complex polar(real r, real t)
	/*
	 * Return r (cos t + i sin t), each part correctly rounded
	 */
    {
	if (t == 0)
	    return r;

	complex compute(int wprec, *real re_err, *real im_err)
	{
	    /* r may have more bits than 'wprec', or be a rational */
	    real	rw = imprecise(r, wprec);
	    real	r_err = 0;
	    real	c_err, s_err;
	    real	c = Math::cos_w(t, wprec, &c_err);
	    real	s = Math::sin_w(t, wprec, &s_err);

	    if (rw != r)
		r_err = Math::abs(rw) * 2**-wprec;
	    *re_err = mul_err(rw, r_err, c, c_err, wprec);
	    *im_err = mul_err(rw, r_err, s, s_err, wprec);
	    return new(rw * c, rw * s);
	}

	return round_correctly(min(part_precision(r), part_precision(t)),
			       compute);
    }

    public complex conj(complex z)
    {
	return new(creal(z), -cimag(z));
    }

    protected real abs(complex z)
    {
	return Math::sqrt(creal(z)**2 + cimag(z)**2);
    }

    public real arg(complex z)
    {
	return Math::atan2(cimag(z), creal(z));
    }

    real log_abs(real x, real y, int prec)
	/*
	 * Return log(sqrt(x**2 + y**2)), correctly rounded to 'prec' bits
	 */
    {
	/* Only these dyadic points lie on the unit circle */
	if ((Math::abs(x) == 1 && y == 0) || (x == 0 && Math::abs(y) == 1))
	    return 0;

	x = imprecise(x);
	y = imprecise(y);
	real compute(int wprec, *real err)
	{
	    /*
	     * h has a relative error under 3 * 2**-wprec, which moves
	     * log(h) by about that much. Near 1, where log would cancel,
	     * h - 1 is exact and log1p keeps its bits
	     */
	    real	xw = imprecise(x, wprec), yw = imprecise(y, wprec);
	    real	h = xw * xw + yw * yw;
	    real	l;

	    if (1/2 < h && h < 2)
		l = Math::log1p(h - 1);
	    else
		l = Math::log(h);

	    *err = (2 + Math::abs(l)) * 2**-wprec;
	    return l / 2;
	}

	return Math::round_correctly(prec, compute);
    }

    protected complex log(complex z)
	/*
	 * Return log(z), each part correctly rounded
	 */
    {
	if (z == 0)
	    raise invalid_argument("log: must be nonzero", 0, z);

	int	prec = part_precision(z);
	real	x = creal(z), y = cimag(z);

	return new(log_abs(x, y, prec),
		   Math::atan2(imprecise(y, prec), imprecise(x, prec)));
    }

    protected complex exp(complex z)
	/*
	 * Return e**z, each part correctly rounded
	 */
    {
	if (z == 0)
	    return 1;
	int	prec = part_precision(z);
	z = imprecise(z, prec);

	complex compute(int wprec, *real re_err, *real im_err)
	{
	    real	e_rel, c_err, s_err;
	    real	e = Math::exp_w(creal(z), wprec, &e_rel);
	    real	c = Math::cos_w(cimag(z), wprec, &c_err);
	    real	s = Math::sin_w(cimag(z), wprec, &s_err);

	    *re_err = mul_err(e, e * e_rel, c, c_err, wprec);
	    *im_err = mul_err(e, e * e_rel, s, s_err, wprec);
	    return new(e * c, e * s);
	}

	return round_correctly(prec, compute);
    }

    int part_exponent(real x)
	/*
	 * Returns the exponent of 'x', or 0 when 'x' is an exact zero
	 */
    {
	return x == 0 ? 0 : exponent(imprecise(x));
    }

    protected complex pow(complex x, complex y)
    {
	if (x == 0) {
	    if (y == 0)
		return 1;
	    if (creal(y) > 0)
		return 0;
	    raise divide_by_zero(1, x);
	}
	int	prec = min(part_precision(x), part_precision(y));

	x = imprecise(x);
	y = imprecise(y);

	/*
	 * x**y = exp(w), w = y log(x). An absolute error in w becomes
	 * that relative error in the result, so compute w with as many
	 * more bits as |w| needs, plus guard bits. With 2**(e-1) <= |x|
	 * < 2**e, |log(x)| is under |e| + 1 + π
	 */
	real	log_bound = Math::abs(part_exponent(abs(x))) + 5;
	int	wprec = prec + guard_bits +
	    max(0, part_exponent(log_bound * abs(y)));
	complex	xi = imprecise(x, wprec);
	complex	yi = imprecise(y, wprec);
	return imprecise(exp(log(xi) * yi), prec);
    }

    protected complex sqrt(complex z)
    {
	real	x = creal(z), y = cimag(z);

	if (y == 0) {
	    if (x >= 0)
		return Math::sqrt(x);
	    return new(0, Math::sqrt(-x));
	}

	/*
	 * Compute the larger part from |z| + |x|, then the smaller as
	 * y / (2 * larger), avoiding the cancellation in |z| - |x|
	 */
	real	t = Math::sqrt((abs(z) + Math::abs(x)) / 2);
	if (x >= 0)
	    return new(t, y / (2 * t));
	if (y > 0)
	    return new(y / (2 * t), t);
	return new(-y / (2 * t), -t);
    }

    /*
     * The inverse functions follow C23 7.3 and Annex G: the branch
     * cuts and ranges are those of casin, cacos, catan, casinh,
     * cacosh, and catanh. Without signed zeros, a point on a cut
     * takes the value reached by going counterclockwise around the
     * cut's finite endpoint (C23 7.3.3), as sqrt and log already do.
     * asin, acos, and acosh use Kahan's formulas from "Branch Cuts
     * for Complex Elementary Functions", which keep their accuracy
     * near the cuts and need no scaling for large arguments.
     */

    protected complex asin(complex z)
    {
	int	prec = part_precision(z);
	z = imprecise(z, prec);
	complex	zp = imprecise(z, prec + guard_bits);
	complex	a = sqrt(1 - zp);
	complex	b = sqrt(1 + zp);

	return imprecise(new(Math::atan2(creal(zp), creal(a * b)),
			     Math::asinh(cimag(conj(a) * b))), prec);
    }

    protected complex acos(complex z)
    {
	int	prec = part_precision(z);
	z = imprecise(z, prec);
	complex	zp = imprecise(z, prec + guard_bits);
	complex	a = sqrt(1 - zp);
	complex	b = sqrt(1 + zp);

	return imprecise(new(2 * Math::atan2(creal(a), creal(b)),
			     Math::asinh(cimag(conj(b) * a))), prec);
    }

    protected complex cos(complex z)
	/*
	 * Return cos(x+iy) = cos x cosh y - i sin x sinh y,
	 * each part correctly rounded
	 */
    {
	if (z == 0)
	    return 1;
	int	prec = part_precision(z);
	z = imprecise(z, prec);

	complex compute(int wprec, *real re_err, *real im_err)
	{
	    real	x = creal(z), y = cimag(z);
	    real	a_err, b_rel, c_err, d_rel;
	    real	a = Math::cos_w(x, wprec, &a_err);
	    real	b = Math::cosh_w(y, wprec, &b_rel);
	    real	c = Math::sin_w(x, wprec, &c_err);
	    real	d = Math::sinh_w(y, wprec, &d_rel);

	    *re_err = mul_err(a, a_err, b, Math::abs(b) * b_rel, wprec);
	    *im_err = mul_err(c, c_err, d, Math::abs(d) * d_rel, wprec);
	    return new(a * b, -(c * d));
	}

	return round_correctly(prec, compute);
    }

    protected complex sin(complex z)
	/*
	 * Return sin(x+iy) = sin x cosh y + i cos x sinh y,
	 * each part correctly rounded
	 */
    {
	if (z == 0)
	    return 0;
	int	prec = part_precision(z);
	z = imprecise(z, prec);

	complex compute(int wprec, *real re_err, *real im_err)
	{
	    real	x = creal(z), y = cimag(z);
	    real	a_err, b_rel, c_err, d_rel;
	    real	a = Math::sin_w(x, wprec, &a_err);
	    real	b = Math::cosh_w(y, wprec, &b_rel);
	    real	c = Math::cos_w(x, wprec, &c_err);
	    real	d = Math::sinh_w(y, wprec, &d_rel);

	    *re_err = mul_err(a, a_err, b, Math::abs(b) * b_rel, wprec);
	    *im_err = mul_err(c, c_err, d, Math::abs(d) * d_rel, wprec);
	    return new(a * b, c * d);
	}

	return round_correctly(prec, compute);
    }

    protected complex tan(complex z)
	/*
	 * tan(x+iy) = (sin 2x + i sinh 2y) / (cos 2x + cosh 2y), avoiding
	 * the cancellation in sin(z) / cos(z), which loses about
	 * 2|y| log2(e) bits of the real part. The denominator is
	 * 2 (cos²x + sinh²y), whose terms can't cancel, as cos 2x and
	 * cosh 2y do near the poles. Each part is correctly rounded
	 */
    {
	if (z == 0)
	    return 0;
	int	prec = part_precision(z);
	z = imprecise(z, prec);

	complex compute(int wprec, *real re_err, *real im_err)
	{
	    real	x = creal(z), y = cimag(z);
	    real	c_err, s_rel, n_err, m_rel, d_err;
	    real	c = Math::cos_w(x, wprec, &c_err);
	    real	s = Math::sinh_w(y, wprec, &s_rel);
	    real	n = Math::sin_w(2 * x, wprec, &n_err);
	    real	m = Math::sinh_w(2 * y, wprec, &m_rel);
	    real	d = twice_sum_squares(c, c_err, s, Math::abs(s) * s_rel,
					      wprec, &d_err);

	    *re_err = div_err(n, n_err, d, d_err, wprec);
	    *im_err = div_err(m, Math::abs(m) * m_rel, d, d_err, wprec);
	    return new(n / d, m / d);
	}

	return round_correctly(prec, compute);
    }

    protected complex cosh(complex z)
	/*
	 * Return cosh(x+iy) = cosh x cos y + i sinh x sin y,
	 * each part correctly rounded
	 */
    {
	if (z == 0)
	    return 1;
	int	prec = part_precision(z);
	z = imprecise(z, prec);

	complex compute(int wprec, *real re_err, *real im_err)
	{
	    real	x = creal(z), y = cimag(z);
	    real	a_rel, b_err, c_rel, d_err;
	    real	a = Math::cosh_w(x, wprec, &a_rel);
	    real	b = Math::cos_w(y, wprec, &b_err);
	    real	c = Math::sinh_w(x, wprec, &c_rel);
	    real	d = Math::sin_w(y, wprec, &d_err);

	    *re_err = mul_err(a, Math::abs(a) * a_rel, b, b_err, wprec);
	    *im_err = mul_err(c, Math::abs(c) * c_rel, d, d_err, wprec);
	    return new(a * b, c * d);
	}

	return round_correctly(prec, compute);
    }

    protected complex sinh(complex z)
	/*
	 * Return sinh(x+iy) = sinh x cos y + i cosh x sin y,
	 * each part correctly rounded
	 */
    {
	if (z == 0)
	    return 0;
	int	prec = part_precision(z);
	z = imprecise(z, prec);

	complex compute(int wprec, *real re_err, *real im_err)
	{
	    real	x = creal(z), y = cimag(z);
	    real	a_rel, b_err, c_rel, d_err;
	    real	a = Math::sinh_w(x, wprec, &a_rel);
	    real	b = Math::cos_w(y, wprec, &b_err);
	    real	c = Math::cosh_w(x, wprec, &c_rel);
	    real	d = Math::sin_w(y, wprec, &d_err);

	    *re_err = mul_err(a, Math::abs(a) * a_rel, b, b_err, wprec);
	    *im_err = mul_err(c, Math::abs(c) * c_rel, d, d_err, wprec);
	    return new(a * b, c * d);
	}

	return round_correctly(prec, compute);
    }

    protected complex tanh(complex z)
	/*
	 * tanh(x+iy) = (sinh 2x + i sin 2y) / (cosh 2x + cos 2y), avoiding
	 * the cancellation in sinh(z) / cosh(z). The denominator is
	 * 2 (sinh²x + cos²y), as for tan. Each part is correctly rounded
	 */
    {
	if (z == 0)
	    return 0;
	int	prec = part_precision(z);
	z = imprecise(z, prec);

	complex compute(int wprec, *real re_err, *real im_err)
	{
	    real	x = creal(z), y = cimag(z);
	    real	s_rel, c_err, n_rel, m_err, d_err;
	    real	s = Math::sinh_w(x, wprec, &s_rel);
	    real	c = Math::cos_w(y, wprec, &c_err);
	    real	n = Math::sinh_w(2 * x, wprec, &n_rel);
	    real	m = Math::sin_w(2 * y, wprec, &m_err);
	    real	d = twice_sum_squares(s, Math::abs(s) * s_rel, c, c_err,
					      wprec, &d_err);

	    *re_err = div_err(n, Math::abs(n) * n_rel, d, d_err, wprec);
	    *im_err = div_err(m, m_err, d, d_err, wprec);
	    return new(n / d, m / d);
	}

	return round_correctly(prec, compute);
    }

    protected complex atanh(complex z)
    {
	real	x = creal(z), y = cimag(z);

	if (Math::abs(x) == 1 && y == 0)
	    raise divide_by_zero(x, 0);
	/*
	 * atanh is odd; computing with x <= 0 puts the cut on the
	 * positive axis below it and the one on the negative axis
	 * above it, as the counterclockwise rule asks
	 */
	if (x > 0)
	    return -atanh(-z);

	int	prec = part_precision(z);
	z = imprecise(z, prec);
	int	wprec = prec + guard_bits;
	x = imprecise(x, wprec);
	y = imprecise(y, wprec);

	/*
	 * Re = log(|1+z|**2 / |1-z|**2) / 4, the ratio being
	 * 1 + 4x / |1-z|**2; log1p keeps the bits of small x, and
	 * near the pole at -1 the ratio itself keeps those of 1+x.
	 * Im = arg((1+z) * conj(1-z)) / 2
	 */
	real	d = (1 - x)**2 + y**2;
	real	q = 4 * x / d;
	real	re;

	if (q > -1/2)
	    re = Math::log1p(q) / 4;
	else
	    re = Math::log(((1 + x)**2 + y**2) / d) / 4;
	return imprecise(new(re, Math::atan2(2 * y, (1 - x) * (1 + x) - y**2) / 2),
			 prec);
    }

    protected complex atan(complex z)
    {
	/* atan(z) = -i atanh(iz) */
	complex	w = atanh(new(-cimag(z), creal(z)));

	return new(cimag(w), -creal(w));
    }

    protected complex asinh(complex z)
    {
	/* asinh(z) = i asin(-iz) */
	complex	w = asin(new(cimag(z), -creal(z)));

	return new(-cimag(w), creal(w));
    }

    protected complex acosh(complex z)
    {
	int	prec = part_precision(z);
	z = imprecise(z, prec);
	complex	zp = imprecise(z, prec + guard_bits);
	complex	a = sqrt(zp - 1);
	complex	b = sqrt(zp + 1);

	return imprecise(new(Math::asinh(creal(conj(a) * b)),
			     2 * Math::atan2(cimag(a), creal(b))), prec);
    }
}
