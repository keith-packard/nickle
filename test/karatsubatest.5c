/*
 * Nickle test suite
 *
 * Karatsuba multiplication tests
 *
 * Products of naturals of at least KARATSUBA_LIMIT (100) digits use
 * Karatsuba multiplication. Check them against products built from
 * pieces small enough to use grade-school multiplication.
 */

autoimport PRNG;

exception bad_product (int a, int b);

/* Pieces of 64 32-bit digits stay below KARATSUBA_LIMIT */
int piece_bits = 2048;

int function grade_school_times (int a, int b)
{
    int	r = 0;
    int	mask = (1 << piece_bits) - 1;

    for (int shift = 0; b != 0; shift += piece_bits) {
	r += (a * (b & mask)) << shift;
	b >>= piece_bits;
    }
    return r;
}

void function check_product (int a, int b)
{
    int	should = grade_school_times (a, b);

    if (a * b != should || b * a != should)
	raise bad_product (a, b);
}

void function check_ones (int abits, int bbits)
{
    int	a = (1 << abits) - 1;
    int	b = (1 << bbits) - 1;

    check_product (a, b);
    if (a * b != (1 << (abits + bbits)) - (1 << abits) - (1 << bbits) + 1)
	raise bad_product (a, b);
}

/*
 * These operands crashed nickle with a heap buffer overflow: the
 * longer one has an odd number of digits and its halves sum to
 * more digits than the scratch space held.
 */
void function check_regression ()
{
    int a = ;
    int b = ;

    check_product (a, b);
}

void function check_sizes ()
{
    /* Digit counts of both parities, balanced and unbalanced */
    int[*] digits = { 100, 101, 127, 128, 199, 200, 253, 254, 506, 507 };

    for (int i = 0; i < dim (digits); i++)
	for (int j = 0; j < dim (digits); j++) {
	    check_ones (digits[i] * 32, digits[j] * 32);
	    check_product (randbits (digits[i] * 32) | 1 << (digits[i] * 32 - 1),
			   randbits (digits[j] * 32) | 1 << (digits[j] * 32 - 1));
	}
}

check_regression ();
check_sizes ();
