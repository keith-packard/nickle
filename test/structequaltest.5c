/*
 * Nickle test suite
 *
 * Comparing structs with different members
 *
 * Comparing structs with the same number of differently named members
 * looked up a missing member and crashed.
 */

exception wrong (string what, poly got, poly want);

void function check (string what, poly got, poly want)
{
    if (got != want)
	raise wrong (what, got, want);
}

poly a = (struct { int x; }) { x = 1 };
poly b = (struct { int y; }) { y = 1 };
poly c = (struct { int x; }) { x = 1 };
check ("different members", a == b, false);
check ("same members", a == c, true);
check ("not equal", a != b, true);
