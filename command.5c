extend namespace Command {

    /*
     * These are used by the parser when building
     * programs to run from the top level of the
     * interpreter
     */

    public void
    display(poly v)
        /*
         * Used by the top-level read/eval/print loop.
         * For non-void 'v',
         *   Prints out 'v' in the current default format.
         *   Inserts 'v' into the history.
         */
    {
        if (is_void(v))
            return;
        History::insert(v);
        printf(format, v);
        putchar('\n');
    }

    public void
    display_base(poly v, int base)
        /*
         * Used by the top-level read/eval/print loop
         * when '# base' is appended to an expression.
         * For non-void 'v',
         *  Prints out 'v' in 'base'.
         *  Inserts 'v' into the history.
         */
    {
        if (is_void(v))
            return;
        History::insert(v);
        File::print(stdout, v, "g", base, 0, -1, " ");
        putchar('\n');
    }

    /* Now add a collection of useful commands */

    noreturn
    do_quit(int args ...)
        /*
         * quit     - exit with code 0
         * quit N   - exit with code N
         */
    {
        int code = 0;

        if (dim(args) > 0)
            code = args[0];
        exit(code);
    }

    new("quit", do_quit);

    void
    do_history(int args ...)
        /*
         * history      - show some recent history
         * history N    - show N recent history
         * history N,M  - show history from N to M
         */
    {
        switch (dim(args)) {
        case 0:
            History::show(format);
            break;
        case 1:
            History::show(format, args[0]);
            break;
        default:
            History::show(format, args[0], args[1]);
            break;
        }
    }

    new("history", do_history);

    string
    format_name(string[*] name)
        /*
         * given an array of namespace component strings,
         * produce a namespace-name
         */
    {
        if (dim(name) == 0)
            return "";
        string result = name[0];
        for (int i = 1; i < dim(name); i++)
            result += sprintf("::%s", name[i]);
        return result;
    }

    void
    name_error(string msg, poly value)
        /*
         * Report a name the print, edit, or undefine command
         * couldn't use: 'value' is the whole name or the part
         * that went wrong
         */
    {
        string name;

        if (is_type(value, string[*]))
            name = format_name(value);
        else
            name = sprintf("%s", value);
        File::fprintf(stderr, "\"%s\": %s\n", name, msg);
    }

    void
    do_pretty_print(poly args ...)
        /*
         * print                - pretty print all public names
         * print name ...       - pretty print given names
         * print namespace::    - print a namespace in full, as written
         * print ::             - print all names in full
         * print "file" ...     - print each file formatted, as written
         */
    {
        string[...] files = {};
        bool        names = false;

        for (int i = 0; i < dim(args); i++) {
            if (is_type(args[i], string)) {
                files[dim(files)] = args[i];
                continue;
            }

            /*
             * The parser ends a name written with a trailing :: with "",
             * and gives :: alone as just ""
             */
            string[*] name = args[i];
            bool      full = false;
            if (name[dim(name) - 1] == "") {
                name = (string[dim(name) - 1]) { [j] = name[j] };
                full = true;
            }
            names = true;
            try {
                if (dim(name) == 0)
                    format_names(stdout, full);
                else
                    format_names(stdout, full, name);
            } catch invalid_argument(string msg, int i, poly value) {
                name_error(msg, value);
            }
        }
        if (!names && dim(files) == 0)
            format_names(stdout, false);

        /* Each file queued is read before those queued earlier */
        for (int i = dim(files) - 1; i >= 0; i--) {
            try {
                format_file(stdout, File::open(files[i], "r"), files[i], true);
            } catch File::open_error(string msg,
                                     File::error_type err,
                                     string name)
            {
                File::fprintf(stderr, "Cannot print \"%s\": %s\n", name, msg);
            }
        }
    }

    new_names("print", do_pretty_print);

    void
    do_edit(string[*] name)
        /* edit name            - edit the definition of name */
    {
        try {
            edit(name);
        } catch invalid_argument(string msg, int i, poly value) {
            name_error(msg, value);
        }
    }

    new_names("edit", do_edit);

    void
    do_undefine(string[*] names ...)
        /* undefine name ...    - remove the given names */
    {
        try {
            undefine(names...);
        } catch invalid_argument(string msg, int i, poly value) {
            name_error(msg, value);
        }
    }

    new_names("undefine", do_undefine);

    void
    do_load(string f)
        /* load "filename"      - read commands from "filename" */
    {
        try {
            lex_file(f);
        } catch File::open_error(string msg,
                                 File::error_type err,
                                 string name)
        {
            File::fprintf(stderr, "Cannot load \"%s\": %s\n", name, msg);
        }
    }

    new("load", do_load);

    string
    make_filename(string[*] m)
        /* construct a filename from a namespace name */
    {
        file r = File::string_write();

        for (int j = 0; j < dim(m); j++) {
            if (j > 0)
                File::putc('-', r);
            bool last_lower = false;
            file name = File::string_read(m[j]);
            while (!File::end(name)) {
                int  c = File::getc(name);
                bool cur_lower = Ctype::islower(c);

                if (Ctype::isupper(c)) {
                    c = Ctype::tolower(c);
                    if (last_lower)
                        File::putc('-', r);
                }
                File::putc(c, r);
                last_lower = cur_lower;
            }
        }
        return File::string_string(r) + ".5c";
    }

    void
    force_import(string[*] name)
        /*
         * force an import of the given name.  XXX horrible
         * kludge of consing up an import command in a string
         * and then lexing it.
         */
    {
        string imp = sprintf("import %s;\n", format_name(name));
        lex_string(imp);
    }

    void
    do_auto(string cmd, string[*][*] args,
            bool do_import, bool reimport)
        /* core behavior for autoload / autoimport / reimport */
    {
        typedef struct {
            file   f;
            string path;
        } library;

        /*
         * Open the files each name needs, outermost namespace first,
         * stopping at the first name with a missing file, so that
         * neither it nor any later name is loaded or imported
         */
        library[...][...] libraries = {};
        int               loaded;

        for (loaded = 0; loaded < dim(args); loaded++) {
            string[*] name = args[loaded];
            bool      missing = false;

            libraries[loaded] = (library[...]) {};
            if (!reimport && valid_name(name))
                continue;
            for (int j = 0; j < dim(name); j++) {
                string[*] subname = (string[j + 1]) { [k] = name[k] };
                if (reimport || !valid_name(subname)) {
                    string  f = make_filename(subname);
                    library l;

                    if (!open_library(f, &l.f, &l.path)) {
                        File::fprintf(
                            stderr, "Cannot %s from " + "file \"%s\", giving up.\n", cmd, f);
                        missing = true;
                        break;
                    }
                    libraries[loaded][dim(libraries[loaded])] = l;
                }
            }
            if (missing)
                break;
        }

        /*
         * The lexer reads what was pushed last first, so push each
         * name's import and then its files, last name first
         */
        for (int i = loaded - 1; i >= 0; i--) {
            if (do_import)
                force_import(args[i]);
            for (int j = dim(libraries[i]) - 1; j >= 0; j--)
                Command::lex_input(libraries[i][j].f, libraries[i][j].path, false, false);
        }
    }

    void
    do_autoimport(string[*] args ...)
        /*
         * autoimport ModuleName ...    -
         *    if needed, load a library named "module-name.5c" and
         *    import ModuleName; do for each argument
         */
    {
        do_auto("autoimport", args, true, false);
    }

    new_names("autoimport", do_autoimport);

    void
    do_reimport(string[*] args ...)
        /*
         * reimport ModuleName ...      -
         *    load a library named "module-name.5c" and
         *    import ModuleName; do for each argument
         */
    {
        do_auto("reimport", args, true, true);
    }

    new_names("reimport", do_reimport);

    void
    do_autoload(string[*] args ...)
        /*
         * autoload ModuleName ...      -
         *    load a library named "module-name.5c".
         */
    {
        do_auto("autoload", args, false, false);
    }

    new_names("autoload", do_autoload);

    void
    do_char(int c ...)
        /* char c1 c2 c3            - Print characters for given integers */
    {
        for (int i = 0; i < dim(c); i++)
            printf("%3d 0x%02x: %v\n", c[i], c[i], String::new(c[i]));
    }

    new("char", do_char);

    /*
     * The files --check-format and --format read, the string
     * files formatting them writes, and whether to write the file back
     */
    typedef struct {
        string name;
        string source;
        file   formatted;
        bool   rewrite;
    } format_check_t;

    format_check_t[...] format_checks = {};
    int                 format_checks_done = 0;
    bool                format_checks_failed = false;

    /* A source file to format, "-" naming stdin */
    file
    format_source(string name)
    {
        if (name == "-")
            return stdin;
        return File::open(name, "r");
    }

    /* The name formatting reports a source by */
    string
    format_source_name(string name)
    {
        if (name == "-")
            return "<stdin>";
        return name;
    }

    void
    format_check(string name, bool rewrite)
        /*
         * Read the file 'name', and format it into a string file,
         * stacking beneath it the command comparing the two, or with
         * 'rewrite', writing the file back when formatting changes it
         */
    {
        file in = format_source(name);
        file source = File::string_write();
        int  b;

        while ((b = File::getb(in)) != -1)
            File::putb(b, source);
        if (in != stdin)
            File::close(in);

        int i = dim(format_checks);
        format_checks[i] = (format_check_t) {
            name = format_source_name(name),
            source = File::string_string(source),
            formatted = File::string_write(),
            rewrite = rewrite,
        };
        lex_string(sprintf("Command::format_check_done(%d)\n", i));
        format_file(
            format_checks[i].formatted, File::string_read(format_checks[i].source),
            format_checks[i].name, true);
    }

    public void
    format_check_done(int i)
        /*
         * Used by --check-format and --format once file 'i'
         * has been formatted: report it when formatting changes it, or
         * write it back, and after the last, exit with status 1 when
         * any check failed or any file couldn't be written
         */
    {
        format_check_t check = format_checks[i];
        string         formatted = File::string_string(check.formatted);
        file           want = File::string_read(check.source);
        file           got = File::string_read(formatted);
        int            line = 1;

        if (check.rewrite) {
            if (formatted != check.source) {
                try {
                    file out = File::open(check.name, "w");

                    File::fputs(formatted, out);
                    File::close(out);
                } catch File::open_error(string msg,
                                         File::error_type err,
                                         string name)
                {
                    File::fprintf(stderr, "Cannot write \"%s\": %s\n", name, msg);
                    format_checks_failed = true;
                }
            }
        } else {
            while (!File::end(want) || !File::end(got)) {
                int c = File::getb(want);

                if (c != File::getb(got)) {
                    File::fprintf(
                        stderr, "%s:%d: formatting changes this line\n", check.name, line);
                    format_checks_failed = true;
                    break;
                }
                if (c == '\n')
                    line++;
            }
        }
        if (++format_checks_done == dim(format_checks) && format_checks_failed)
            exit(1);
    }

    void
    process_args(&string[*] argv)
        /* parse nickle command-line arguments */
    {
        bool   lex_stdin = true;
        string script_name = "";

        /*
         * XXX Much of this architecture is driven by
         * the fact that the lexer stacks the
         * files to be processed rather than queueing them.
         */

        typedef union {
            string library;
            string sfile;
            string script;
            string expr;
            string format;
            string pretty;
            string check_format;
        } lexable;

        lexable[...] lexables = {};

        void
        process_lexables()
        {
        }

        void
        save_lexable(lexable l)
        {
            lexables[dim(lexables)] = l;
        }

        void
        save_library(string arg)
        {
            save_lexable((lexable.library) arg);
        }

        /* Whether to format, print formatted, or check the files given, not run them */
        bool format_files = false;
        bool pretty_files = false;
        bool check_files = false;
        bool formatting_files = false;

        /*
         * Find the libraries a file being formatted loads as a script
         * would, beside it, or for stdin, "-", in the current directory
         */
        void
        format_path(string arg)
        {
            if (arg == "-")
                nickle_path += ":.";
            else
                nickle_path = String::dirname(arg) + ":" + nickle_path;
        }

        /*
         * Save a file to format, print formatted, or check, "-" naming
         * stdin, which formatting can't write back to
         */
        void
        save_formatted(string arg)
        {
            if (format_files && arg == "-") {
                File::fprintf(stderr, "Cannot format stdin in place; use --pretty\n");
                exit(1);
            }
            if (format_files)
                save_lexable((lexable.format) arg);
            else if (pretty_files)
                save_lexable((lexable.pretty) arg);
            else
                save_lexable((lexable.check_format) arg);
            format_path(arg);
            formatting_files = true;
            lex_stdin = false;
        }

        void
        save_script(string arg)
        {
            /* In a formatting mode, the script and its arguments are the files */
            if (format_files || pretty_files || check_files) {
                save_formatted(arg);
                return;
            }
            script_name = arg;

            /* As in Python, "-" reads the script from stdin */
            if (arg == "-") {
                lex_stdin = true;
                return;
            }
            save_lexable((lexable.script) arg);

            /* Add directory containing the script to the library path */
            nickle_path = String::dirname(arg) + ":" + nickle_path;
            lex_stdin = false;
        }

        void
        save_file(string arg)
        {
            save_lexable((lexable.sfile) arg);
        }

        void
        save_expr(string arg)
        {
            save_lexable((lexable.expr) arg);
            lex_stdin = false;
        }

        bool               show_version = false;

        ParseArgs::argdesc argd = {
            args = {
                { var = { arg_lambda = save_library }, abbr = 'l',
                  name = "library", expr_name = "lib", desc = "Library to load." },
                { var = { arg_lambda = save_file }, abbr = 'f', name = "file",
                  expr_name = "source", desc = "Source file to load." },
                { var = { arg_lambda = save_expr }, abbr = 'e', name = "expr",
                  expr_name = "expression", desc = "Expression to evaluate." },
                { var = { arg_flag = &format_files }, abbr = 'F', name = "format",
                  desc = "Format the source files given, rewriting each that changes." },
                { var = { arg_flag = &pretty_files }, abbr = 'P', name = "pretty",
                  desc = "Print the source files given formatted, without running them." },
                { var = { arg_flag = &check_files }, abbr = 'C', name = "check-format",
                  desc = "Check that formatting leaves the source files given unchanged." },
                { var = { arg_flag = &show_version }, abbr = 'V',
                  name = "version", desc = "Print the Nickle version and exit" },
            },
            posn_args = {
                { var = { arg_lambda = save_script }, name = "script", optional = <> }
            },
            unknown = &(int user_argind),
            prog_name = "nickle"
        };

        /* actually parse the arguments */
        ParseArgs::parseargs(&argd, &argv);

        if (show_version) {
            printf("Nickle %s\n", version);
            exit(0);
        }

        /*
         * Formatting takes the rest of the arguments as files too;
         * printing or checking with none reads stdin
         */
        if (format_files || pretty_files || check_files) {
            int modes = 0;

            if (format_files)
                modes++;
            if (pretty_files)
                modes++;
            if (check_files)
                modes++;
            if (modes > 1) {
                File::fprintf(stderr, "Choose one of --format, --pretty, and --check-format\n");
                exit(1);
            }
            if (!is_uninit(&user_argind)) {
                for (int i = user_argind; i < dim(argv); i++)
                    save_formatted(argv[i]);
                user_argind = dim(argv);
            }
            if (!formatting_files) {
                if (format_files) {
                    File::fprintf(stderr, "--format needs the files to format\n");
                    exit(1);
                }
                save_formatted("-");
            }
        }

        /* Reset argv to hold remaining arguments */
        if (lex_stdin && script_name == "" && is_uninit(&user_argind)) {
            string[0] rest = {};
            argv = rest;
        } else {
            if (is_uninit(&user_argind))
                user_argind = dim(argv);
            string[dim(argv) - user_argind + 1] rest;
            rest[0] = script_name;
            for (int i = 1; i < dim(rest); i++)
                rest[i] = argv[i + user_argind - 1];
            argv = rest;
        }

        /*
         * Recall the comment above.  Since the lexer
         * stacks, we must stack stdin, which is to run last,
         * *before* the other stuff.  Bleah.
         */
        if (lex_stdin) {

            /* Add the current directory to the library path */
            nickle_path += ":.";

            /* we want stdin to be processed after all other lexables */
            lex_input(stdin, "<stdin>", false, File::isatty(stdin));
        }

        /* now stack the other arguments, in reverse order */
        for (int i = dim(lexables) - 1; i >= 0; --i) {

            static noreturn
            load_fail(string name, string msg)
            {
                File::fprintf(stderr, "Cannot load \"%s\": %s\n", name, msg);
                exit(1);
            }

            static void
            lex_script(string arg)
            {
                try {
                    lex_file(arg);
                } catch File::open_error(string msg,
                                         File::error_type err,
                                         string name)
                {
                    load_fail(name, msg);
                }
            }

            union switch (lexables[i]) {
            case library arg:
                if (!lex_library(arg))
                    load_fail(arg, "cannot load library");
                break;
            case script arg:
                lex_script(arg);
                break;
            case sfile arg:
                lex_script(arg);
                break;
            case expr arg:
                lex_string(arg + "\n");
                break;
            case pretty arg:
                try {
                    format_file(stdout, format_source(arg), format_source_name(arg), true);
                } catch File::open_error(string msg,
                                         File::error_type err,
                                         string name)
                {
                    load_fail(name, msg);
                }
                break;
            case format arg:
                try {
                    format_check(arg, true);
                } catch File::open_error(string msg,
                                         File::error_type err,
                                         string name)
                {
                    load_fail(name, msg);
                }
                break;
            case check_format arg:
                try {
                    format_check(arg, false);
                } catch File::open_error(string msg,
                                         File::error_type err,
                                         string name)
                {
                    load_fail(name, msg);
                }
                break;
            }

            /* Errors in command-line input, unlike stdin, are fatal */
            lex_exit_on_error(true);
        }

        /*
         * As Python does with PYTHONSTARTUP, load $NICKLERC, else
         * ~/.nicklerc, only when reading commands from a terminal.
         * Stacked last, it runs first, and like stdin, its errors
         * are reported without exiting. A missing ~/.nicklerc is
         * fine, but a missing $NICKLERC gets a warning
         */
        if (lex_stdin && File::isatty(stdin)) {
            bool   named = Environ::check("NICKLERC") && Environ::get("NICKLERC") != "";
            string rc = "";

            if (named)
                rc = Environ::get("NICKLERC");
            else if (Environ::check("HOME"))
                rc = Environ::get("HOME") + "/.nicklerc";
            if (rc != "") {
                try {
                    lex_file(rc);
                    lex_exit_on_error(false);
                } catch File::open_error(string msg,
                                         File::error_type err,
                                         string name)
                {
                    if (named)
                        File::fprintf(stderr, "Cannot load \"%s\": %s\n", name, msg);
                }
            }
        }
    }
}
