 * See the file COPYING in this directory for licensing information.
 *
 * Check that the grammar's ignorenl and attendnl rules pair up.
 *
 * parseIgnorenl counts how many grammar constructs want newlines ignored: the empty rule
 * ignorenl adds one and attendnl takes one away, stopping at zero. Every construct must take
 * away what it added, after adding it, so that attendnl never stops at zero and the count is
 * zero whenever reset ends a command. This finds each nonterminal's net change to the count
 * and the lowest the count falls below its start along any derivation, and checks that:
 *
 *  - every rule ends with its ';';
 *  - the alternatives of each nonterminal agree on its net change;
 *  - the count never falls below zero from the start of the input;
 *  - the count is zero at each reset;
 *  - only ignorenl, attendnl, and reset change the count
 *    in rule actions, and the C code only clears it.
 *
 * Bison reduces left to right, so a rule's actions run in the order
 * its symbols appear. Actions count as symbols with no change.
 *
 * Usage: nickle check-ignorenl.5c gram.y
 */

string         count_name = "parseIgnorenl";
string         start = "lines";
string         action = "{action}";

/* The rules that change the count, by how much, and how their action writes it */
int[string]    rule_net = { "ignorenl" => 1, "attendnl" => -1, "reset" => 0 };
string[string] rule_write = {
    "ignorenl" => "add", "attendnl" => "subtract", "reset" => "clear" };
string[string] write_words = {
    "add" => "add one to", "subtract" => "take one from", "clear" => "clear" };

typedef struct {
    string    lhs;
    string[*] symbols;
    int[*]    action_starts;
    int[*]    action_ends;
    int       line;
} rule_t;

typedef int[...] ints;

string      path = argv[1];
string[...] problems = {};

void
problem(int line, string message)
{
    if (line > 0)
        problems[dim(problems)] = sprintf("%s:%d: %s", path, line, message);
    else
        problems[dim(problems)] = sprintf("%s: %s", path, message);
}

/* n with its sign, as "+1", "0", or "-1" */
string
signed(int n)
{
    if (n > 0)
        return sprintf("+%d", n);
    return sprintf("%d", n);
}

int[*]
read_code_points(string name)
{
    file     f = File::open(name, "r");
    int[...] cs = {};

    while (!File::end(f))
        cs[dim(cs)] = File::getc(f);
    File::close(f);
    return cs;
}

int[*]
code_points(string s)
{
    file     f = File::string_read(s);
    int[...] cs = {};

    while (!File::end(f))
        cs[dim(cs)] = File::getc(f);
    return cs;
}

string
text(int[*] cs, int from, int to)
{
    file f = File::string_write();

    for (int i = from; i < to; i++)
        File::putc(cs[i], f);
    return File::string_string(f);
}

/* Replace comments with spaces, keeping newlines, so positions and lines stay put */
int[*]
strip_comments(int[*] cs)
{
    int[dim(cs)] out = { [i] = cs[i] };
    int          n = dim(cs);

    for (int i = 0; i < n - 1; i++) {
        if (cs[i] == '/' && cs[i + 1] == '*') {
            int j = i + 2;

            while (j < n - 1 && !(cs[j] == '*' && cs[j + 1] == '/'))
                j++;
            for (int k = i; k < j + 2 && k < n; k++)
                if (cs[k] != '\n')
                    out[k] = ' ';
            i = j + 1;
        } else if (cs[i] == '/' && cs[i + 1] == '/') {
            while (i < n && cs[i] != '\n')
                out[i++] = ' ';
        }
    }
    return out;
}

/* The line holding each position */
int[*]
line_numbers(int[*] cs)
{
    int[dim(cs) + 1] lines;
    int              line = 1;

    for (int i = 0; i < dim(cs); i++) {
        lines[i] = line;
        if (cs[i] == '\n')
            line++;
    }
    lines[dim(cs)] = line;
    return lines;
}

bool
is_space(int c) = c == ' ' || c == '\t' || c == '\n' || c == '\r' || c == '\f';

bool
is_digit(int c) = '0' <= c && c <= '9';

bool
is_name_start(int c)
{
    return 'a' <= c && c <= 'z' || 'A' <= c && c <= 'Z'
        || c == '_' || c == '.' || c == '$';
}

bool
is_name(int c) = is_name_start(c) || is_digit(c);

/* Return the position past the action's closing brace, starting at its opening one */
int
action_end(int[*] cs, int i, int end)
{
    int depth = 0;

    for (; i < end; i++) {
        int c = cs[i];
        if (c == '"' || c == '\'') {
            i++;
            while (i < end && cs[i] != c) {
                if (cs[i] == '\\')
                    i++;
                i++;
            }
        } else if (c == '{') {
            depth++;
        } else if (c == '}') {
            if (--depth == 0)
                return i + 1;
        }
    }
    return -1;
}

/* The rules between from and to, an alternative each; stops at the first syntax problem */
rule_t[*]
parse_rules(int[*] cs, int[*] lines, int from, int to)
{
    rule_t[...] rules = {};
    string      lhs = "";
    string[...] symbols = {};
    int[...]    action_starts = {};
    int[...]    action_ends = {};
    int         line = 0;
    int         i = from;

    void
    finish()
    {
        rules[dim(rules)] = (rule_t) {
            lhs = lhs, symbols = symbols, action_starts = action_starts,
            action_ends = action_ends, line = line };
        symbols = (string[...]) {};
        action_starts = (int[...]) {};
        action_ends = (int[...]) {};
    }

    while (i < to) {
        int c = cs[i];
        if (is_space(c)) {
            i++;
        } else if (c == '{') {
            int end = action_end(cs, i, to);

            if (end < 0) {
                problem(lines[i], "unterminated action");
                return rules;
            }
            symbols[dim(symbols)] = action;
            action_starts[dim(action_starts)] = i;
            action_ends[dim(action_ends)] = end;
            i = end;
        } else if (c == '|') {
            finish();
            line = lines[i];
            i++;
        } else if (c == ';') {
            finish();
            lhs = "";
            i++;
        } else if (c == '\'') {
            int end = i + 1;

            if (cs[end] == '\\')
                end++;
            end++;
            while (end < to && cs[end] != '\'')
                end++;
            symbols[dim(symbols)] = text(cs, i, end + 1);
            i = end + 1;
        } else if (c == '%') {
            int end = i + 1;

            while (end < to && is_name(cs[end]))
                end++;
            string directive = text(cs, i, end);
            i = end;
            if (directive == "%prec") {
                while (i < to && is_space(cs[i]))
                    i++;
                while (i < to && !is_space(cs[i]))
                    i++;
            } else if (directive != "%empty") {
                problem(lines[i], sprintf("unexpected %s", directive));
                return rules;
            }
        } else if (is_name_start(c)) {
            int end = i;

            while (end < to && is_name(cs[end]))
                end++;
            string name = text(cs, i, end);
            int    after = end;
            while (after < to && is_space(cs[after]))
                after++;
            if (after < to && cs[after] == ':') {
                if (lhs != "") {
                    problem(lines[i], sprintf("%s has no ';' before %s", lhs, name));
                    return rules;
                }
                lhs = name;
                line = lines[i];
                i = after + 1;
            } else {
                symbols[dim(symbols)] = name;
                i = end;
            }
        } else {
            problem(lines[i], sprintf("unexpected '%c'", c));
            return rules;
        }
    }
    if (lhs != "")
        problem(lines[to - 1], sprintf("%s has no ';' at the end", lhs));
    return rules;
}

/* Whether cs holds the characters of s at i */
bool
holds(int[*] cs, int i, string s)
{
    int[*] want = code_points(s);

    if (i < 0 || i + dim(want) > dim(cs))
        return false;
    for (int k = 0; k < dim(want); k++)
        if (cs[i + k] != want[k])
            return false;
    return true;
}

/* The positions of the count's name between from and to */
int[*]
find_count(int[*] cs, int from, int to)
{
    int[*]   name = code_points(count_name);
    int[...] found = {};

    for (int i = from; i + dim(name) <= to; i++) {
        if (cs[i] != name[0] || !holds(cs, i, count_name))
            continue;
        if (i > 0 && is_name(cs[i - 1]))
            continue;
        if (i + dim(name) < dim(cs) && is_name(cs[i + dim(name)]))
            continue;
        found[dim(found)] = i;
    }
    return found;
}

/*
 * How the count's name at i is written: "add", "subtract",
 * "clear", "other", or "" when it is only read
 */
string
write_kind(int[*] cs, int i)
{
    int before = i - 1;
    int after = i + dim(code_points(count_name));

    while (before > 0 && is_space(cs[before]))
        before--;
    if (holds(cs, before - 1, "++"))
        return "add";
    if (holds(cs, before - 1, "--"))
        return "subtract";
    while (after < dim(cs) && is_space(cs[after]))
        after++;
    if (holds(cs, after, "++"))
        return "add";
    if (holds(cs, after, "--"))
        return "subtract";
    if (holds(cs, after, "+=") || holds(cs, after, "-="))
        return "other";
    if (holds(cs, after, "=") && !holds(cs, after, "==")) {
        after++;
        while (after < dim(cs) && is_space(cs[after]))
            after++;
        if (!holds(cs, after, "0"))
            return "other";
        after++;
        while (after < dim(cs) && is_space(cs[after]))
            after++;
        if (holds(cs, after, ";"))
            return "clear";
        return "other";
    }
    return "";
}

/* The kinds of writes to the count between from and to */
string[*]
writes(int[*] cs, int from, int to)
{
    string[...] kinds = {};
    int[*]      found = find_count(cs, from, to);

    for (int f = 0; f < dim(found); f++) {
        string kind = write_kind(cs, found[f]);
        if (kind != "")
            kinds[dim(kinds)] = kind;
    }
    return kinds;
}

/* The net change of a sequence of symbols, and its lowest point in *lowest */
int
walk(string[*] symbols, int[string] net, int[string] low, &int lowest)
{
    int count = 0;

    lowest = 0;
    for (int k = 0; k < dim(symbols); k++) {
        string s = symbols[k];

        if (!hash_test(net, s))
            continue;
        if (count + low[s] < lowest)
            lowest = count + low[s];
        count += net[s];
    }
    return count;
}

typedef struct {
    string symbol;
    int    count;
    int    parent;
    int    line;
} state_t;

/*
 * A derivation from the start reaching a rule that takes the count below zero, as "lines ->
 * ... -> attendnl", found breadth first, entering each nonterminal with each count once;
 * recursion can raise the count without end, so stop once it passes every rule's worth
 */
string
witness(rule_t[*] rules, ints[string] alternatives, int[string] net, &int line)
{
    state_t[...] queue = { { symbol = start, count = 0, parent = -1, line = 0 } };
    bool[string] seen = { sprintf("%s %d", start, 0) => true };

    for (int q = 0; q < dim(queue); q++) {
        state_t state = queue[q];

        if (!hash_test(alternatives, state.symbol))
            continue;
        for (int a = 0; a < dim(alternatives[state.symbol]); a++) {
            int r = alternatives[state.symbol][a];
            int at = state.count;
            for (int k = 0; k < dim(rules[r].symbols); k++) {
                string s = rules[r].symbols[k];

                if (!hash_test(net, s))
                    continue;
                if (hash_test(rule_net, s) && at + rule_net[s] < 0) {
                    string chain = s;

                    line = rules[r].line;
                    for (int p = q; p >= 0; p = queue[p].parent)
                        chain = queue[p].symbol + " -> " + chain;
                    return chain;
                }
                string key = sprintf("%s %d", s, at);
                if (!hash_test(rule_net, s) && !hash_test(seen, key) && at <= dim(rules)) {
                    seen[key] = true;
                    queue[dim(queue)] =
                        (state_t) { symbol = s, count = at, parent = q, line = rules[r].line };
                }
                at += net[s];
            }
        }
    }
    line = 0;
    return start;
}

void
check()
{
    int[*]   source = read_code_points(path);
    int[*]   cs = strip_comments(source);
    int[*]   lines = line_numbers(cs);

    /* The lines holding just %% bound the rules */
    int[...] marks = {};

    for (int i = 0; i < dim(cs); i++) {
        if ((i == 0 || cs[i - 1] == '\n') && holds(cs, i, "%%")) {
            int end = i + 2;

            while (end < dim(cs) && cs[end] != '\n' && is_space(cs[end]))
                end++;
            if (end == dim(cs) || cs[end] == '\n')
                marks[dim(marks)] = i;
        }
    }
    if (dim(marks) != 2) {
        problem(0, "expected two lines of %%");
        return;
    }
    int       from = marks[0] + 2;
    int       to = marks[1];

    rule_t[*] rules = parse_rules(cs, lines, from, to);
    if (dim(problems) > 0)
        return;

    ints[string] alternatives = {};
    for (int r = 0; r < dim(rules); r++) {
        string lhs = rules[r].lhs;

        if (!hash_test(alternatives, lhs))
            alternatives[lhs] = (int[...]) {};
        alternatives[lhs][dim(alternatives[lhs])] = r;
    }

    /* Only the three rules change the count; the C code only clears it */
    for (int r = 0; r < dim(rules); r++) {
        rule_t rule = rules[r];
        for (int a = 0; a < dim(rule.action_starts); a++) {
            string[*] kinds = writes(cs, rule.action_starts[a], rule.action_ends[a]);
            int       at = lines[rule.action_starts[a]];
            if (hash_test(rule_net, rule.lhs)) {
                string expect = rule_write[rule.lhs];
                if (dim(rule.symbols) != 1 || dim(kinds) != 1 || kinds[0] != expect)
                    problem(at,
                            sprintf("%s should be empty and only %s %s",
                                    rule.lhs, write_words[expect], count_name));
            } else if (dim(kinds) > 0) {
                problem(at, sprintf("%s action changes %s", rule.lhs, count_name));
            }
        }
    }
    int[*] found = find_count(cs, 0, dim(cs));
    for (int f = 0; f < dim(found); f++) {
        int i = found[f];

        if (from <= i && i < to)
            continue;
        string kind = write_kind(cs, i);
        if (kind != "" && kind != "clear")
            problem(
                lines[i], sprintf("C code changes %s other than clearing it", count_name));
    }

    /*
     * Each nonterminal's net change and lowest point, found by repeating until
     * nothing changes; a nonterminal taking away more than it adds, recursively,
     * would fall without end, so stop once anything falls past every rule's worth
     */
    int[string] net = {};
    int[string] low = {};
    int         lowest_low = 0;
    string[*]   counted = hash_keys(rule_net);
    for (int k = 0; k < dim(counted); k++) {
        string lhs = counted[k];

        net[lhs] = rule_net[lhs];
        low[lhs] = min(rule_net[lhs], 0);
    }
    bool changed = true;
    while (changed && lowest_low >= -dim(rules)) {
        changed = false;
        for (int r = 0; r < dim(rules); r++) {
            rule_t rule = rules[r];

            if (hash_test(rule_net, rule.lhs))
                continue;
            bool ready = true;
            for (int k = 0; k < dim(rule.symbols); k++)
                if (hash_test(alternatives, rule.symbols[k])
                        && !hash_test(net, rule.symbols[k]))
                    ready = false;
            if (!ready)
                continue;
            int lowest;
            int count = walk(rule.symbols, net, low, &lowest);
            if (!hash_test(net, rule.lhs)) {
                net[rule.lhs] = count;
                low[rule.lhs] = lowest;
                changed = true;
            } else if (lowest < low[rule.lhs]) {
                low[rule.lhs] = lowest;
                changed = true;
            }
            lowest_low = min(lowest_low, lowest);
        }
    }

    for (int r = 0; r < dim(rules); r++) {
        rule_t rule = rules[r];
        string missing = "";

        for (int k = 0; k < dim(rule.symbols); k++) {
            string s = rule.symbols[k];
            if (missing == "" && hash_test(alternatives, s) && !hash_test(net, s))
                missing = s;
        }
        if (missing != "") {
            problem(rule.line, sprintf("%s never derives", missing));
            continue;
        }
        int lowest;
        int count = walk(rule.symbols, net, low, &lowest);
        if (!hash_test(rule_net, rule.lhs) && count != net[rule.lhs])
            problem(rule.line,
                    sprintf("%s alternative changes %s by %s, others by %s", rule.lhs,
                            count_name, signed(count), signed(net[rule.lhs])));
        for (int k = 0; k < dim(rule.symbols); k++) {
            if (rule.symbols[k] != "reset")
                continue;
            string[k] before = { [j] = rule.symbols[j] };
            int       at = walk(before, net, low, &lowest);
            if (at != 0)
                problem(rule.line,
                        sprintf("%s is %s at reset in %s", count_name, signed(at), rule.lhs));
        }
    }
    if (!hash_test(net, start)) {
        problem(0, sprintf("%s never derives", start));
    } else if (low[start] < 0 || net[start] != 0) {
        int    line;
        string chain = witness(rules, alternatives, net, &line);
        problem(line, sprintf("%s can fall below zero: %s", count_name, chain));
    }
}

check();
for (int p = 0; p < dim(problems); p++)
    printf("%s\n", problems[p]);
exit(dim(problems) > 0 ? 1 : 0);
