/*
 * Nickle test suite
 *
 * Errors from Foreign::load
 *
 * Foreign::load raised open_error with a plain int where the exception
 * declares a File::error_type, so handlers written as declared couldn't
 * catch it.
 */

exception not_raised (string what);
exception wrong (string what, poly got, poly want);

void function check (string what, poly got, poly want)
{
    if (got != want)
	raise wrong (what, got, want);
}

try {
    Foreign::load ("/nonexistent/library.so");
    raise not_raised ("Foreign::load");
} catch File::open_error (string m, File::error_type e, string name) {
    check ("load name", name, "/nonexistent/library.so");
}
