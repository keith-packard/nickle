/*
 * Nickle test suite
 *
 * Float precisions and exponents too large for an int
 *
 * float_precision was read without checking that it was a small int,
 * so a larger value set the precision from the bits of its pointer.
 * Converting a float to an integer truncated its exponent to an int,
 * so floor (Math::ldexp (imprecise (1), 2**70)) returned 1.
 */

exception not_raised (string what);
exception wrong (string what, poly got, poly want);

void function check (string what, poly got, poly want)
{
    if (got != want)
	raise wrong (what, got, want);
}

/* Results too large to represent raise out_of_memory */
void function too_large (string what, poly() f)
{
    try {
	f ();
	raise not_raised (what);
    } catch out_of_memory (string m) {
    }
}

too_large ("floor (ldexp (1, 2**70))",
	   poly func () { return floor (Math::ldexp (imprecise (1), 2**70)); });
too_large ("ceil (ldexp (-1, 2**70))",
	   poly func () { return ceil (Math::ldexp (imprecise (-1), 2**70)); });
too_large ("imprecise (1/3, 2**70)",
	   poly func () { return imprecise (1/3, 2**70); });

/* An exponent that fits still converts exactly */
check ("floor (ldexp (3, 100))", floor (Math::ldexp (imprecise (3), 100)), 3 * 2**100);

/* Values far below one floor and ceil to 0 or -1 */
real tiny = Math::ldexp (imprecise (1), -(2**70));
check ("floor (tiny)", floor (tiny), 0);
check ("ceil (tiny)", ceil (tiny), 1);
check ("floor (-tiny)", floor (-tiny), -1);
check ("ceil (-tiny)", ceil (-tiny), 0);

/* float_precision too large to use raises out_of_memory */
float_precision = 2**70;
too_large ("float_precision = 2**70", poly func () { return imprecise (1/3); });

/* float_precision below 2, however large, selects the default */
float_precision = -(2**70);
check ("float_precision = -(2**70)", precision (imprecise (1/3)), 256);

float_precision = 1000;
check ("float_precision = 1000", precision (imprecise (1/3)), 1000);
check ("promoted precision", precision (imprecise (1/3) + 1), 1000);

float_precision = 256;
