/*
 * Nickle test suite
 *
 * Error values raised by PID functions
 *
 * PID::system_error carried a plain int where the exception declares a
 * File::error_type, so handlers written as declared couldn't catch it.
 */

exception not_raised (string what);
exception wrong (string what, poly got, poly want);

void function check (string what, poly got, poly want)
{
    if (got != want)
	raise wrong (what, got, want);
}

/* Only a process that isn't root fails to become root */
if (PID::getuid () != 0) {
    try {
	PID::setuid (0);
	raise not_raised ("PID::setuid");
    } catch PID::system_error (string m, File::error_type e, poly v) {
	check ("setuid error", e, File::error_type.PERM);
    }
}
