/*
 * Nickle test suite
 *
 * Reading doc strings
 *
 * The lexer appended each byte of a doc string to the string read so
 * far as a character of its own, copying the string for every byte and
 * encoding each byte of a UTF-8 character as a character. A doc string
 * of 2¹⁹ characters took over a minute to read.
 */

exception wrong(string what, poly got, poly want);

void
check(string what, poly got, poly want)
{
    if (got ≠ want)
        raise wrong(what, got, want);
}

string nickle = Environ::get("NICKLE");
string name = "docstringtest.tmp";

/* Print the function f defined with doc string doc */
string
print_doc(string doc)
{
    file f = File::open(name, "w");

    File::fprintf(f, "int f()\n/*%s*/\n{ return 1; }\nprint f;\n", doc);
    File::close(f);

    file[*] out = File::mkpipe();

    File::filter(
        nickle, (string[*]) { nickle, name }, (file[3]) { stdin, out[1], stderr });
    File::close(out[1]);

    string printed = "";
    while (!File::end(out[0]))
        printed += File::fgets(out[0]) + "\n";
    File::close(out[0]);
    File::unlink(name);
    return printed;
}

check("utf-8", print_doc(" π ≥ 3 "),
      "int\nf()\n    /* π ≥ 3 */\n{\n    return 1;\n}\n");

int    n = 2¹⁹;
string doc = String::new((int[n]) { [i] = 'a' + i % 26 });

check("long", print_doc(doc),
      "int\nf()\n    /* " + doc + " */\n{\n    return 1;\n}\n");
