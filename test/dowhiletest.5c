/*
 * Nickle test suite
 *
 * do-while and its semicolon
 *
 * The grammar ended do-while at the parenthesis after its condition,
 * so the ';' written after it, as in C, was an empty statement of its
 * own; inside an if, it came between the if and its else, which was a
 * syntax error. The ';' now belongs to the do-while, and may still be
 * left out.
 */

exception wrong(string what, poly got, poly want);

void
check(string what, poly got, poly want)
{
    if (got != want)
        raise wrong(what, got, want);
}

int x = 0, y = 0;

if (x == 0)
    do
        x++;
    while (x < 3);
else
    y = 1;
check("if", x, 3);
check("else", y, 0);

do
    x++;
while (x < 5);
check("without ;", x, 5);

int
count(int limit)
{
    int n = 0;

    do {
        n++;
    } while (n < limit);
    return n;
}

check("block", count(4), 4);
check("once", count(0), 1);
