/*
 * Nickle test suite
 *
 * printf formats
 */

exception bad_format (string format, poly arg, string got, string want);

void check (string format, poly arg, string want)
{
    string	got = sprintf (format, arg);

    if (got != want)
	raise bad_format (format, arg, got, want);
}

/*
 * A zero fill goes after the sign, as in C; it went before, giving
 * 00-42
 */
check ("%05d", -42, "-0042");
check ("%05d", 42, "00042");
check ("%05x", -42, "-002a");
check ("%030d", -(2**70), "-00000001180591620717411303424");
check ("%08.2f", -3/2, "-0001.50");
check ("%08.2f", imprecise (-1.5), "-0001.50");
check ("%012a", imprecise (-1.5), "-0x00001.8p0");
check ("%-05d", -42, "-42  ");
check ("%5d", -42, "  -42");
check ("%05c", '-', "0000-");

/*
 * %e scales any number to [1, base). Exact values were scaled only
 * below 1, and 2/3 was missed; integers never were, and a float zero
 * got exponent -2
 */
check ("%e", 1/3, "3.333333333333333e-1");
check ("%e", 2/3, "6.666666666666667e-1");
check ("%.3e", 2/3, "6.667e-1");
check ("%.3e", -2/3, "-6.667e-1");
check ("%e", 9/100, "9e-2");
check ("%e", -3/2, "-1.5e0");
check ("%.3e", 1500/7, "2.143e2");
check ("%e", 10**20/3, "3.333333333333333e19");
check ("%e", 1/10**20, "1e-20");
/* Rounding may carry to the next exponent */
check ("%.3e", 99996/10000, "1.000e1");
check ("%.3e", 999999/1000000, "1.000e0");
check ("%e", 150, "1.5e2");
check ("%e", -1, "-1e0");
check ("%.3e", 2**100, "1.268e30");
check ("%e", 0, "0e0");
check ("%.2e", 0, "0.00e0");
check ("%e", imprecise (0), "0e0");
check ("%.3e", imprecise (0), "0.000e0");
check ("%12.3e", 2/3, "    6.667e-1");
check ("%012.3e", -1/7000, "-0001.429e-4");

/* A percent conversion with flags takes no argument */
if (sprintf ("[%5%][%-3%][%.2%] %d", 7) != "[%][%][%] 7")
    raise bad_format ("%5%", 7, sprintf ("[%5%][%-3%][%.2%] %d", 7),
		      "[%][%][%] 7");

/* The type error names the format */
try {
    sprintf ("%d", "x");
    raise bad_format ("%d", "x", "", "invalid_argument");
} catch invalid_argument (string msg, int arg, poly value) {
    if (msg != "int format with non-int")
	raise bad_format ("%d", "x", msg, "int format with non-int");
}

/*
 * Precision 0 rounds to a whole number and prints no point. Exact
 * values truncated, integers printed a point, and a width made floats
 * ignore it
 */
check ("%.0f", 5/2, "2");
check ("%.0f", 13/5, "3");
check ("%.0f", -13/5, "-3");
check ("%.0f", 2/3, "1");
check ("%.0f", 1/3, "0");
check ("%.0e", 2/3, "7e-1");
check ("%5.0f", imprecise (2.5), "    2");
check ("%-5.0f", -13/5, "-3   ");
check ("%05.0f", -13/5, "-0003");
check ("%.0f", 3, "3");
check ("%5.0f", -(2**70), "-1180591620717411303424");

/*
 * A tie rounds to an even last digit, as arithmetic and C do; ties
 * rounded away from zero
 */
real f (real x) = imprecise (x, 53);

check ("%.0f", 1/2, "0");
check ("%.0f", 3/2, "2");
check ("%.0f", -5/2, "-2");
check ("%.2f", 1/8, "0.12");
check ("%.2f", 3/8, "0.38");
check ("%.2f", -1/8, "-0.12");
check ("%.3f", 12345/10000, "1.234");
check ("%.3f", 12355/10000, "1.236");
check ("%.1f", 95/100, "1.0");
check ("%.1e", 125/1000, "1.2e-1");
check ("%.0e", 25, "2e1");
check ("%.0e", 35, "4e1");
check ("%.0f", f (0.5), "0");
check ("%.0f", f (-2.5), "-2");
check ("%.2f", f (0.125), "0.12");
check ("%.2f", f (0.375), "0.38");
check ("%.1e", f (0.125), "1.2e-1");
check ("%.1e", f (1250), "1.2e3");
check ("%.0e", f (35), "4e1");

/*
 * Exponents are decimal in every base, introduced by '@' above base
 * 10, where 'e' is a digit, as in GMP and MPFR. Floats wrote them in
 * the base and rationals in decimal, both after 'e', so 3 * 16**10
 * printed as 3.00ea and 3.00e10
 */
string sprint (real x, int base, int prec)
{
    file	s = File::string_write ();

    File::print (s, x, "e", base, 0, prec, " ");
    return File::string_string (s);
}

void check_base (real x, int base, int prec, string want)
{
    string	got = sprint (x, base, prec);

    if (got != want)
	raise bad_format (sprintf ("%%.%de base %d", prec, base), x, got, want);
}

void check_both (real x, int base, string want)
{
    check_base (f (x), base, 2, want);
    check_base (x, base, 2, want);
}

check_both (3 * 2**40, 2, "1.10e41");
check_both (3 * 2**40, 10, "3.30e12");
check_both (3 * 2**40, 11, "1.06@12");
check_both (3 * 2**40, 16, "3.00@10");
check_both (3 / 4 / 16**10, 16, "c.00@-11");
check_both (35 * 36**12, 36, "z.00@12");
check_both (-11 / 12**30, 11, "-8.99@-31");

/*
 * %e of a float rounds its exact value. It scaled the value by a
 * rounded power of the base, so values at or near a half could round
 * either way: 65 printed as 7e1, 1500 as 1e3, and -67/2 in base 7 as
 * -5.0e1
 */

check ("%.0e", f (65), "6e1");
check ("%.0e", f (1500), "2e3");
check ("%.1e", f (105), "1.0e2");
check ("%.1e", f (-69/2), "-3.4e1");
check ("%.3g", f (13531/2), "6.766e3");
check_base (f (-67/2), 7, 1, "-4.6e1");
check_base (f (-69), 6, 1, "-2.0e2");

/*
 * These lie so near a half in their last digit, 2.7373862122447495
 * 49999...e54 and 1.0263280850068802 49999...e-32, that printing them
 * takes a second, more precise pass
 */
check ("%.17e", f (0x1.c9463a6ef709ap180), "2.7373862122447495e54");
check ("%.17e", f (0x1.aa51ec0012becp-107), "1.0263280850068802e-32");

/* Floats with exact ties and near misses print as the same rationals */
for (int base = 2; base <= 16; base++)
    for (int prec = 0; prec <= 3; prec++)
	for (int k = 1; k < 100; k += 2)
	    for (int sh = -6; sh <= 30; sh += 3) {
		rational	x = k * 2**sh / 4;

		check_base (f (x), base, prec, sprint (x, base, prec));
		check_base (f (x + 2**(sh - 40)), base, prec, sprint (x + 2**(sh - 40), base, prec));
	    }

/*
 * A fixed-point float shows the digits its precision holds, counted
 * from its first significant digit. The zeros after the point counted
 * against the precision, so %.20f of 1e-10 stopped at 0.00000000010000000
 */
check ("%.20f", f (1e-10), "0.00000000010000000000");
check ("%.20f", f (0.0025), "0.0025000000000000001");
